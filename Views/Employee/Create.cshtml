@model itpayroll.ViewModels.EmployeeViewModel
@{
    ViewData["Title"] = "Add Employee";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Add Employee</h4>
    <small class="text-muted">Create a new employee record. User account will be auto-generated.</small>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Personal Information -->
            <h6 class="mb-3">Personal Information</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <!-- Auto-generated by controller, shown on success page -->

            <hr />

            <!-- Employment Information -->
            <h6 class="mb-3">Employment Information</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Models.EmploymentStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BasicSalary" class="form-label"></label>
                    <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ShiftId" class="form-label"></label>
                    <select asp-for="ShiftId" class="form-select" asp-items="ViewBag.Shifts">
                        <option value="">-- Select Shift --</option>
                    </select>
                    <span asp-validation-for="ShiftId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="HireDate" class="form-label"></label>
                    <input asp-for="HireDate" class="form-control" type="date" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Department" class="form-label"></label>
                    <input asp-for="Department" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EmploymentType" class="form-label"></label>
                    <select asp-for="EmploymentType" class="form-select">
                        <option value="">Select...</option>
                        <option value="0">Regular</option>
                        <option value="1">Contractual</option>
                        <option value="2">Probationary</option>
                        <option value="3">PartTime</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TerminationDate" class="form-label"></label>
                    <input asp-for="TerminationDate" class="form-control" type="date" />
                </div>
            </div>

            <hr />

            <!-- Payroll Information -->
            <h6 class="mb-3">Payroll Information</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SalaryType" class="form-label"></label>
                    <select asp-for="SalaryType" class="form-select">
                        <option value="0">Monthly</option>
                        <option value="1">Daily</option>
                        <option value="2">Hourly</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PayFrequency" class="form-label"></label>
                    <select asp-for="PayFrequency" class="form-select">
                        <option value="0">Monthly</option>
                        <option value="1">Semi-Monthly</option>
                        <option value="2">Weekly</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BankName" class="form-label"></label>
                    <input asp-for="BankName" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BankAccountNumber" class="form-label"></label>
                    <input asp-for="BankAccountNumber" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="TIN" class="form-label"></label>
                    <input asp-for="TIN" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="SSSNumber" class="form-label"></label>
                    <input asp-for="SSSNumber" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="PhilHealthNumber" class="form-label"></label>
                    <input asp-for="PhilHealthNumber" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="PagIBIGNumber" class="form-label"></label>
                    <input asp-for="PagIBIGNumber" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">Create Employee</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
