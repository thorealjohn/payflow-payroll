@using itpayroll.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Personnel Details";
    var userRoles = Model.User != null ? await UserManager.GetRolesAsync(Model.User) : new List<string>();
    var role = userRoles.FirstOrDefault() ?? "—";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Personnel Details</h4>
    <small class="text-muted">View employee information</small>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Employee Number</dt>
            <dd class="col-sm-9">@Model.EmployeeNumber</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.User?.FirstName @Model.User?.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.User?.Email</dd>

            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@role</span></dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@(Model.Department ?? "—")</dd>

            <dt class="col-sm-3">Position</dt>
            <dd class="col-sm-9">@(Model.Position ?? "—")</dd>

            @if (Model.BasicSalary > 0)
            {
                <dt class="col-sm-3">Basic Salary</dt>
                <dd class="col-sm-9">₱@Model.BasicSalary.ToString("N2")</dd>
            }

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == itpayroll.Models.EmploymentStatus.Active ? "bg-success" : "bg-danger")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Hire Date</dt>
            <dd class="col-sm-9">@Model.HireDate.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3">Termination Date</dt>
            <dd class="col-sm-9">@(Model.TerminationDate?.ToString("MMM dd, yyyy") ?? "N/A")</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CreatedBy on @Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

            @if (Model.ModifiedDate.HasValue)
            {
                <dt class="col-sm-3">Modified By</dt>
                <dd class="col-sm-9">@Model.ModifiedBy on @Model.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
