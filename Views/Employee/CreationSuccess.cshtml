@{
    ViewData["Title"] = "Account Created";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Account Created Successfully</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Important:</strong> Give these credentials to the employee. They will be required to change their password on first login.
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <input value="@ViewBag.CreatedEmail" class="form-control" disabled />
                            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@ViewBag.CreatedEmail')">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Temporary Password</label>
                        <div class="input-group">
                            <input id="tempPassword" value="@ViewBag.TempPassword" class="form-control" disabled />
                            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@ViewBag.TempPassword')">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <small class="text-muted">This password will not be shown again after leaving this page.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" onclick="printCredentials()">
                            <i class="fas fa-print me-2"></i>Print / Save
                        </button>
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">
                            Back to Employee List
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body text-center text-muted">
                    <small>This page will automatically clear the password from memory after 5 minutes.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('Copied to clipboard!');
        }, function() {
            alert('Failed to copy. Please select and copy manually.');
        });
    }

    function printCredentials() {
        window.print();
    }

    // Clear password from display after 5 minutes
    setTimeout(function() {
        var passField = document.getElementById('tempPassword');
        if (passField) {
            passField.value = '***HIDDEN***';
        }
    }, 5 * 60 * 1000);
</script>
