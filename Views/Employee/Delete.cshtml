@model itpayroll.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Delete Employee</h4>
    <small class="text-muted">This action cannot be undone</small>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete this employee record?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Employee Number</dt>
            <dd class="col-sm-9">@Model.EmployeeNumber</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.User?.FirstName @Model.User?.LastName</dd>

            <dt class="col-sm-3">Basic Salary</dt>
            <dd class="col-sm-9">₱@Model.BasicSalary.ToString("N2")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="EmployeeId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
