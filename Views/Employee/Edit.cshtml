@model itpayroll.ViewModels.EmployeeViewModel
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Edit Employee</h4>
    <small class="text-muted">Update employee information and system access role</small>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="EmployeeId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MiddleName" class="form-label"></label>
                    <input asp-for="MiddleName" class="form-control" />
                    <span asp-validation-for="MiddleName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Suffix" class="form-label"></label>
                    <input asp-for="Suffix" class="form-control" />
                    <span asp-validation-for="Suffix" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Areas.Identity.Data.Gender>()">
                        <option value="">-- Select Gender --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CivilStatus" class="form-label"></label>
                    <select asp-for="CivilStatus" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Areas.Identity.Data.CivilStatus>()">
                        <option value="">-- Select Civil Status --</option>
                    </select>
                    <span asp-validation-for="CivilStatus" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nationality" class="form-label"></label>
                    <input asp-for="Nationality" class="form-control" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <h6 class="mb-3">Contact Information</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AddressStreet" class="form-label"></label>
                    <input asp-for="AddressStreet" class="form-control" />
                    <span asp-validation-for="AddressStreet" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AddressBarangay" class="form-label"></label>
                    <input asp-for="AddressBarangay" class="form-control" />
                    <span asp-validation-for="AddressBarangay" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="AddressCity" class="form-label"></label>
                    <input asp-for="AddressCity" class="form-control" />
                    <span asp-validation-for="AddressCity" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="AddressProvince" class="form-label"></label>
                    <input asp-for="AddressProvince" class="form-control" />
                    <span asp-validation-for="AddressProvince" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="AddressZipCode" class="form-label"></label>
                    <input asp-for="AddressZipCode" class="form-control" />
                    <span asp-validation-for="AddressZipCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="EmergencyContactName" class="form-label"></label>
                    <input asp-for="EmergencyContactName" class="form-control" />
                    <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EmergencyContactRelationship" class="form-label"></label>
                    <input asp-for="EmergencyContactRelationship" class="form-control" />
                    <span asp-validation-for="EmergencyContactRelationship" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EmergencyContactPhone" class="form-label"></label>
                    <input asp-for="EmergencyContactPhone" class="form-control" />
                    <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <select asp-for="Role" class="form-select" asp-items="ViewBag.AllowedRoles" id="roleSelect">
                            <option value="">-- Select Role --</option>
                        </select>
                    }
                    else
                    {
                        <input asp-for="Role" class="form-control" readonly />
                    }
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Models.EmploymentStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EmployeeNumber" class="form-label"></label>
                    <input asp-for="EmployeeNumber" class="form-control" />
                    <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DepartmentId" class="form-label"></label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" id="departmentSelect" required>
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PositionId" class="form-label"></label>
                    <select asp-for="PositionId" class="form-select" asp-items="ViewBag.Positions" id="positionSelect" required>
                        <option value="">-- Select Position --</option>
                    </select>
                    <span asp-validation-for="PositionId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ShiftId" class="form-label"></label>
                    <select asp-for="ShiftId" class="form-select" asp-items="ViewBag.Shifts">
                        <option value="">-- Select Shift --</option>
                    </select>
                    <span asp-validation-for="ShiftId" class="text-danger"></span>
                </div>
            </div>

            <!-- Employee payroll fields -->
            <div id="employeeOnlyFields">
                <hr />
                <h6 class="mb-3">Payroll Details</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BasicSalary" class="form-label"></label>
                        <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="BasicSalary" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" class="form-control" type="date" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TerminationDate" class="form-label"></label>
                    <input asp-for="TerminationDate" class="form-control" type="date" />
                    <span asp-validation-for="TerminationDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmploymentType" class="form-label"></label>
                    <select asp-for="EmploymentType" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Models.EmploymentType>()" id="employmentTypeSelect">
                        <option value="">-- Select Employment Type --</option>
                    </select>
                    <span asp-validation-for="EmploymentType" class="text-danger"></span>
                </div>

                <hr />
                <h6 class="mb-3">Payroll Information</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SalaryType" class="form-label"></label>
                        <select asp-for="SalaryType" class="form-select">
                            <option value="0">Monthly</option>
                            <option value="1">Daily</option>
                            <option value="2">Hourly</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BankName" class="form-label"></label>
                        <input asp-for="BankName" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BankAccountNumber" class="form-label"></label>
                        <input asp-for="BankAccountNumber" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="TIN" class="form-label"></label>
                        <input asp-for="TIN" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="SSSNumber" class="form-label"></label>
                        <input asp-for="SSSNumber" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="PhilHealthNumber" class="form-label"></label>
                        <input asp-for="PhilHealthNumber" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="PagIBIGNumber" class="form-label"></label>
                        <input asp-for="PagIBIGNumber" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var roleDefaults = @Html.Raw(ViewBag.RoleDefaults ?? "{}");

        document.addEventListener('DOMContentLoaded', function () {
            var roleSelect = document.getElementById('roleSelect');
            var departmentSelect = document.getElementById('departmentSelect');
            var positionSelect = document.getElementById('positionSelect');
            var employeeFields = document.getElementById('employeeOnlyFields');
            var salaryInput = document.getElementById('BasicSalary');
            var shiftSelect = document.getElementById('ShiftId');
            var employmentTypeSelect = document.getElementById('employmentTypeSelect');

            function toggleEmployeeFields() {
                employeeFields.style.display = 'block';
                if (salaryInput) salaryInput.required = true;
                if (shiftSelect) shiftSelect.required = true;
                if (employmentTypeSelect) employmentTypeSelect.required = true;
            }

            function applyRoleDefaults() {
                var defaults = roleDefaults[roleSelect.value];
                if (defaults) {
                    if (defaults.departmentId) {
                        departmentSelect.value = defaults.departmentId;
                        loadPositions(defaults.departmentId, defaults.positionId || null);
                        return;
                    }
                    if (defaults.positionId) {
                        positionSelect.value = defaults.positionId;
                    }
                }
            }

            function loadPositions(departmentId, selectedPositionId) {
                positionSelect.innerHTML = '<option value="">-- Select Position --</option>';
                positionSelect.disabled = true;
                if (!departmentId) {
                    positionSelect.disabled = false;
                    return;
                }

                fetch('@Url.Action("GetPositionsByDepartment", "Employee")?departmentId=' + departmentId)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        data.forEach(function (p) {
                            var opt = document.createElement('option');
                            opt.value = p.positionId;
                            opt.text = p.name;
                            if (selectedPositionId && p.positionId == selectedPositionId) {
                                opt.selected = true;
                            }
                            positionSelect.appendChild(opt);
                        });
                        positionSelect.disabled = false;
                    });
            }

            departmentSelect.addEventListener('change', function () {
                loadPositions(this.value, null);
            });

            roleSelect.addEventListener('change', function () {
                toggleEmployeeFields();
                applyRoleDefaults();
            });

            toggleEmployeeFields();
        });
    </script>
}
