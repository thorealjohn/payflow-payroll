@model ChangePasswordViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="fw-semibold mb-3">Change Password</h5>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="text-muted small mb-4">
                        Enter your temporary or current password, then choose a new password.
                    </p>
                }

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label"></label>
                        <div class="position-relative">
                            <input asp-for="OldPassword" class="form-control pe-5" autocomplete="current-password" id="changeOldPassword" />
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleChangeOldPassword" style="z-index: 5; text-decoration: none; background: none;">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <div class="position-relative">
                            <input asp-for="NewPassword" class="form-control pe-5" autocomplete="new-password" id="changeNewPassword" />
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleChangeNewPassword" style="z-index: 5; text-decoration: none; background: none;">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="position-relative">
                            <input asp-for="ConfirmPassword" class="form-control pe-5" autocomplete="new-password" id="changeConfirmPassword" />
                            <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleChangeConfirmPassword" style="z-index: 5; text-decoration: none; background: none;">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleChangeOldPassword').addEventListener('click', function () {
            var input = document.getElementById('changeOldPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
        document.getElementById('toggleChangeNewPassword').addEventListener('click', function () {
            var input = document.getElementById('changeNewPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
        document.getElementById('toggleChangeConfirmPassword').addEventListener('click', function () {
            var input = document.getElementById('changeConfirmPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
    </script>
}
