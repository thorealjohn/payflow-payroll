@model LoginViewModel
@inject IConfiguration Configuration
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center fw-bold mb-3">Welcome Back</h3>
                <p class="text-center text-muted mb-4">Login to your PayFlow account</p>

                <form asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="Password" class="form-control pe-5" placeholder="Password" autocomplete="current-password" id="loginPassword" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleLoginPassword" style="z-index: 5; text-decoration: none; background: none;">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="g-recaptcha mb-3" data-sitekey="@Configuration["GoogleReCaptcha:SiteKey"]" "></div>

                    <button type="submit" class="w-100 btn btn-success btn-lg fw-semibold">
                        Log in
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        document.getElementById('toggleLoginPassword').addEventListener('click', function () {
            var input = document.getElementById('loginPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
    </script>
}
