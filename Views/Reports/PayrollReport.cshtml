@model List<itpayroll.Models.Payroll>
@using itpayroll.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Payroll Report";
    var earningsByPayroll = ViewBag.EarningsByPayroll as Dictionary<int, List<Earning>> ?? new Dictionary<int, List<Earning>>();
    var deductionsByPayroll = ViewBag.DeductionsByPayroll as Dictionary<int, List<Deduction>> ?? new Dictionary<int, List<Deduction>>();
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="fw-bold mb-0">Payroll Report</h4>
        <small class="text-muted">How much are we paying and where are payroll costs going?</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPayrollExcel"
           asp-route-period="@ViewBag.Period"
           asp-route-customDateFrom="@ViewBag.CustomDateFrom"
           asp-route-customDateTo="@ViewBag.CustomDateTo"
           asp-route-employeeId="@ViewBag.SelectedEmployee"
           asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
           class="btn btn-success">
            <i class="fas fa-file-excel me-1"></i> Excel
        </a>
        <a asp-action="ExportPayrollPdf"
           asp-route-period="@ViewBag.Period"
           asp-route-customDateFrom="@ViewBag.CustomDateFrom"
           asp-route-customDateTo="@ViewBag.CustomDateTo"
           asp-route-employeeId="@ViewBag.SelectedEmployee"
           asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
           class="btn btn-danger">
            <i class="fas fa-file-pdf me-1"></i> PDF
        </a>
    </div>
</div>

<div class="small text-muted mb-3">
    Generated by: <strong>@ViewBag.GeneratedBy</strong> |
    Generated on: <strong>@(((DateTime)ViewBag.GeneratedOn).ToString("MMM dd, yyyy hh:mm tt"))</strong> |
    Date Range: <strong>@ViewBag.DateRangeText</strong>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Gross Pay</div>
                <div class="h4 mb-0">₱@(((decimal)ViewBag.TotalGrossPay).ToString("N2"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Deductions</div>
                <div class="h4 mb-0">₱@(((decimal)ViewBag.TotalDeductions).ToString("N2"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Net Pay</div>
                <div class="h4 mb-0">₱@(((decimal)ViewBag.TotalNetPay).ToString("N2"))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Employees Paid</div>
                <div class="h4 mb-0">@ViewBag.EmployeesPaid</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <select name="period" class="form-select">
            <option value="Today" selected="@(ViewBag.Period == "Today")">Today</option>
            <option value="ThisWeek" selected="@(ViewBag.Period == "ThisWeek")">This Week</option>
            <option value="ThisMonth" selected="@(ViewBag.Period == "ThisMonth")">This Month</option>
            <option value="ThisYear" selected="@(ViewBag.Period == "ThisYear")">This Year</option>
            <option value="Custom" selected="@(ViewBag.Period == "Custom")">Custom</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="customDateFrom" class="form-control" value="@ViewBag.CustomDateFrom" />
    </div>
    <div class="col-md-2">
        <input type="date" name="customDateTo" class="form-control" value="@ViewBag.CustomDateTo" />
    </div>
    <div class="col-md-2">
        <select name="employeeId" class="form-select tom-select">
            <option value="">All Employees</option>
            @foreach (var emp in ViewBag.Employees as List<SelectListItem> ?? new List<SelectListItem>())
            {
                <option value="@emp.Value" selected="@(ViewBag.SelectedEmployee?.ToString() == emp.Value)">@emp.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="department" class="form-select">
            <option value="">All Departments</option>
            @foreach (var dept in ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>())
            {
                <option value="@dept.Value" selected="@(ViewBag.SelectedDepartment == dept.Value)">@dept.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="payrollStatus" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in ViewBag.PayrollStatuses as List<string> ?? new List<string>())
            {
                <option value="@s" selected="@(ViewBag.SelectedPayrollStatus == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="PayrollReport" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0">Payroll Trend (Last 6 Periods)</h6>
    </div>
    <div class="card-body">
        <canvas id="payrollTrendChart" style="max-height:220px;"></canvas>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0">Payroll Records</h6>
            <small class="text-muted">@ViewBag.TotalRows record(s) found</small>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Pay Period</th>
                    <th class="px-4">Gross Pay</th>
                    <th class="px-4">Deductions</th>
                    <th class="px-4">Net Pay</th>
                    <th class="px-4">Status</th>
                    <th class="px-4">Breakdown</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="px-4">@p.Employee?.EmployeeNumber - @p.Employee?.User?.FirstName @p.Employee?.User?.LastName</td>
                        <td class="px-4">@p.PeriodStart.ToString("MMM dd, yyyy") - @p.PeriodEnd.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">₱@p.GrossPay.ToString("N2")</td>
                        <td class="px-4">₱@p.TotalDeductions.ToString("N2")</td>
                        <td class="px-4">₱@p.NetPay.ToString("N2")</td>
                        <td class="px-4">
                            <span class="badge @(p.Status == PayrollStatus.Released ? "bg-success" : p.Status == PayrollStatus.Approved ? "bg-info" : p.Status == PayrollStatus.PendingApproval ? "bg-warning" : p.Status == PayrollStatus.Processed ? "bg-warning text-dark" : "bg-secondary")">
                                @p.Status
                            </span>
                        </td>
                        <td class="px-4">
                            <details>
                                <summary class="small text-primary" style="cursor:pointer;">View</summary>
                                <div class="small mt-2">
                                    <div class="fw-semibold">Earnings</div>
                                    <ul class="mb-2">
                                        @foreach (var e in earningsByPayroll.GetValueOrDefault(p.PayrollId, new List<Earning>()))
                                        {
                                            <li>@e.Type: ₱@e.Amount.ToString("N2")</li>
                                        }
                                        @if (!earningsByPayroll.ContainsKey(p.PayrollId))
                                        {
                                            <li class="text-muted">No earnings items.</li>
                                        }
                                    </ul>
                                    <div class="fw-semibold">Deductions</div>
                                    <ul class="mb-2">
                                        @foreach (var d in deductionsByPayroll.GetValueOrDefault(p.PayrollId, new List<Deduction>()))
                                        {
                                            <li>@d.Type: ₱@d.Amount.ToString("N2")</li>
                                        }
                                        @if (!deductionsByPayroll.ContainsKey(p.PayrollId))
                                        {
                                            <li class="text-muted">No deduction items.</li>
                                        }
                                    </ul>
                                    <div class="fw-semibold">Net Pay: ₱@p.NetPay.ToString("N2")</div>
                                </div>
                            </details>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No payroll records found.</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-semibold">
                    <td class="px-4" colspan="2">Totals</td>
                    <td class="px-4">₱@(((decimal)ViewBag.TotalGrossPay).ToString("N2"))</td>
                    <td class="px-4">₱@(((decimal)ViewBag.TotalDeductions).ToString("N2"))</td>
                    <td class="px-4">₱@(((decimal)ViewBag.TotalNetPay).ToString("N2"))</td>
                    <td class="px-4" colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center px-4 py-3">
    <small class="text-muted">Page @current of @total</small>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="PayrollReport" asp-route-page="@(current - 1)"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           asp-route-employeeId="@ViewBag.SelectedEmployee" asp-route-department="@ViewBag.SelectedDepartment" asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
           class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

        @if (start > 1)
        {
            <a asp-action="PayrollReport" asp-route-page="1"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               asp-route-employeeId="@ViewBag.SelectedEmployee" asp-route-department="@ViewBag.SelectedDepartment" asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
               class="btn btn-sm btn-outline-primary">1</a>
            @if (start > 2) { <span class="px-2">...</span> }
        }

        @for (int i = start; i <= end; i++)
        {
            <a asp-action="PayrollReport" asp-route-page="@i"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               asp-route-employeeId="@ViewBag.SelectedEmployee" asp-route-department="@ViewBag.SelectedDepartment" asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
               class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
        }

        @if (end < total)
        {
            @if (end < total - 1) { <span class="px-2">...</span> }
            <a asp-action="PayrollReport" asp-route-page="@total"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               asp-route-employeeId="@ViewBag.SelectedEmployee" asp-route-department="@ViewBag.SelectedDepartment" asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
               class="btn btn-sm btn-outline-primary">@total</a>
        }

        <a asp-action="PayrollReport" asp-route-page="@(current + 1)"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           asp-route-employeeId="@ViewBag.SelectedEmployee" asp-route-department="@ViewBag.SelectedDepartment" asp-route-payrollStatus="@ViewBag.SelectedPayrollStatus"
           class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const trend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyTrend));
        const ctx = document.getElementById('payrollTrendChart')?.getContext('2d');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trend.map(x => x.Month),
                    datasets: [{
                        label: 'Monthly Payroll Cost',
                        data: trend.map(x => x.Total),
                        borderColor: '#7c3aed',
                        backgroundColor: 'rgba(124,58,237,0.15)',
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
    </script>
}
