@{
    ViewData["Title"] = "Reports";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Reports Dashboard</h4>
    <small class="text-muted">Generate and export payroll, attendance, and employee reports</small>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-money-bill-wave fa-3x text-success mb-3"></i>
                <h5 class="card-title">Payroll Report</h5>
                <p class="card-text text-muted">Generate payroll summary reports with filters</p>
                <a asp-action="PayrollReport" class="btn btn-primary">Generate Report</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-3x text-warning mb-3"></i>
                <h5 class="card-title">Attendance Report</h5>
                <p class="card-text text-muted">View attendance records with late/undertime details</p>
                <a asp-action="AttendanceReport" class="btn btn-primary">Generate Report</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-users fa-3x text-info mb-3"></i>
                <h5 class="card-title">Employee Report</h5>
                <p class="card-text text-muted">Export employee directory with salary and shift info</p>
                <a asp-action="EmployeeReport" class="btn btn-primary">Generate Report</a>
            </div>
        </div>
    </div>
</div>
