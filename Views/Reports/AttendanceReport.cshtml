@model List<itpayroll.Models.Attendance>
@using itpayroll.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Attendance Report";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="fw-bold mb-0">Attendance Report</h4>
        <small class="text-muted">Who is underperforming, late, absent, or missing logs?</small>
    </div>
    <div>
        <a asp-action="ExportAttendanceExcel"
           asp-route-dateFrom="@ViewBag.DateFrom"
           asp-route-dateTo="@ViewBag.DateTo"
           asp-route-employeeId="@ViewBag.SelectedEmployee"
           class="btn btn-success">
            <i class="fas fa-file-excel me-1"></i> Export Excel
        </a>
    </div>
</div>

<div class="small text-muted mb-3">
    Generated by: <strong>@ViewBag.GeneratedBy</strong> |
    Generated on: <strong>@(((DateTime)ViewBag.GeneratedOn).ToString("MMM dd, yyyy hh:mm tt"))</strong> |
    Date Range: <strong>@ViewBag.DateRangeText</strong>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Present Employees</div><div class="h4 mb-0">@ViewBag.PresentEmployees</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Late Employees</div><div class="h4 mb-0">@ViewBag.LateEmployees</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Absent Employees</div><div class="h4 mb-0">@ViewBag.AbsentEmployees</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Average Hours Worked</div><div class="h4 mb-0">@(((double)ViewBag.AverageHoursWorked).ToString("N2"))</div></div></div></div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
    </div>
    <div class="col-md-2">
        <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
    </div>
    <div class="col-md-2">
        <select name="employeeId" class="form-select">
            <option value="">All Employees</option>
            @foreach (var emp in ViewBag.Employees as List<SelectListItem> ?? new List<SelectListItem>())
            {
                <option value="@emp.Value" selected="@(ViewBag.SelectedEmployee?.ToString() == emp.Value)">@emp.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="shiftId" class="form-select">
            <option value="">All Shifts</option>
            @foreach (var s in ViewBag.Shifts as List<SelectListItem> ?? new List<SelectListItem>())
            {
                <option value="@s.Value" selected="@(ViewBag.SelectedShift?.ToString() == s.Value)">@s.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="department" class="form-select">
            <option value="">All Departments</option>
            @foreach (var dept in ViewBag.Departments as List<string> ?? new List<string>())
            {
                <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept)">@dept</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="AttendanceReport" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body small">
                <div class="fw-semibold mb-1">Most Late Employee</div>
                <div>@ViewBag.MostLateEmployee</div>
                <div class="text-muted">@ViewBag.MostLateMinutes min total late</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body small">
                <div class="fw-semibold mb-1">Most Overtime Hours</div>
                <div>@ViewBag.MostOvertimeEmployee</div>
                <div class="text-muted">@(((double)ViewBag.MostOvertimeHours).ToString("N2")) hrs overtime</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body small">
                <div class="fw-semibold mb-1">Highest Attendance Rate</div>
                <div>@ViewBag.HighestAttendanceEmployee</div>
                <div class="text-muted">@(((double)ViewBag.AttendanceRate).ToString("N2"))% overall attendance rate</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0">Attendance Records</h6>
            <small class="text-muted">@ViewBag.TotalRows record(s) found | Open Logs: @ViewBag.OpenLogs</small>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Date</th>
                    <th class="px-4">Time In</th>
                    <th class="px-4">Time Out</th>
                    <th class="px-4">Status</th>
                    <th class="px-4">Total Hours</th>
                    <th class="px-4">Late</th>
                    <th class="px-4">Undertime</th>
                    <th class="px-4">Night Shift (hrs)</th>
                    <th class="px-4">Shift</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var openShift = a.TimeOut == default || a.TimeOut <= a.TimeIn;
                    var status = openShift ? "Incomplete" : (a.LateMinutes > 0 ? "Late" : "Present");
                    var rowClass = openShift ? "table-danger" : a.LateMinutes > 0 ? "table-warning" : a.UndertimeMinutes > 0 ? "table-warning" : "";
                    <tr class="@rowClass">
                        <td class="px-4">@a.Employee?.EmployeeNumber - @a.Employee?.User?.FirstName @a.Employee?.User?.LastName</td>
                        <td class="px-4">@a.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@a.TimeIn.ToString(@"hh\:mm")</td>
                        <td class="px-4">@(openShift ? "Missing" : a.TimeOut.ToString(@"hh\:mm"))</td>
                        <td class="px-4">
                            <span class="badge @(status == "Incomplete" ? "bg-danger" : status == "Late" ? "bg-warning text-dark" : "bg-success")">@status</span>
                        </td>
                        <td class="px-4">@a.TotalHours.ToString("N2")</td>
                        <td class="px-4">
                            @(a.LateMinutes > 0 ? $"{a.LateMinutes / 60}h {a.LateMinutes % 60}m" : "0h 0m")
                        </td>
                        <td class="px-4">
                            @(a.UndertimeMinutes > 0 ? $"{a.UndertimeMinutes / 60}h {a.UndertimeMinutes % 60}m" : "0h 0m")
                        </td>
                        <td class="px-4">@a.NightShiftHours.ToString("N2")</td>
                        <td class="px-4">
                            @(a.Shift?.ShiftName ?? "Unassigned")
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">No attendance records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="AttendanceReport"
                   asp-route-dateFrom="@ViewBag.DateFrom"
                   asp-route-dateTo="@ViewBag.DateTo"
                   asp-route-employeeId="@ViewBag.SelectedEmployee"
                   asp-route-shiftId="@ViewBag.SelectedShift"
                   asp-route-department="@ViewBag.SelectedDepartment"
                   asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>
