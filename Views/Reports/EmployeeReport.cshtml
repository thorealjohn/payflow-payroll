@model List<itpayroll.Models.Employee>
@using itpayroll.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Employee Report";
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="fw-bold mb-0">Employee Report</h4>
        <small class="text-muted">What is our workforce composition and staffing profile?</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportEmployeeExcel"
           asp-route-search="@ViewBag.Search"
           asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-employmentType="@ViewBag.SelectedEmploymentType"
           asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-success">
            <i class="fas fa-file-excel me-1"></i> Excel
        </a>
        <a asp-action="ExportEmployeePdf"
           asp-route-search="@ViewBag.Search"
           asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-employmentType="@ViewBag.SelectedEmploymentType"
           asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-danger">
            <i class="fas fa-file-pdf me-1"></i> PDF
        </a>
    </div>
</div>

<div class="small text-muted mb-3">
    Generated by: <strong>@ViewBag.GeneratedBy</strong> |
    Generated on: <strong>@(((DateTime)ViewBag.GeneratedOn).ToString("MMM dd, yyyy hh:mm tt"))</strong> |
    Date Range: <strong>@ViewBag.DateRangeText</strong>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Total Employees</div><div class="h4 mb-0">@ViewBag.TotalEmployees</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Active Employees</div><div class="h4 mb-0">@ViewBag.ActiveEmployees</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Departments</div><div class="h4 mb-0">@ViewBag.DepartmentsCount</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">New Hires (This Month)</div><div class="h4 mb-0">@ViewBag.NewHires</div></div></div></div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Name, email, employee #" />
    </div>
    <div class="col-md-3">
        <select name="department" class="form-select">
            <option value="">All Departments</option>
            @foreach (var dept in ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>())
            {
                <option value="@dept.Value" selected="@(ViewBag.SelectedDepartment == dept.Value)">@dept.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="employmentType" class="form-select">
            <option value="">All Types</option>
            @foreach (var t in ViewBag.EmploymentTypes as List<string> ?? new List<string>())
            {
                <option value="@t" selected="@(ViewBag.SelectedEmploymentType == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in ViewBag.EmploymentStatuses as List<string> ?? new List<string>())
            {
                <option value="@s" selected="@(ViewBag.SelectedStatus == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a asp-action="EmployeeReport" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0">Employee Directory</h6>
            <small class="text-muted">@ViewBag.TotalRows record(s) found</small>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Profile</th>
                    <th class="px-4">Employee #</th>
                    <th class="px-4">Name</th>
                    <th class="px-4">Email</th>
                    <th class="px-4">Department</th>
                    <th class="px-4">Employment Type</th>
                    <th class="px-4">Basic Salary</th>
                    <th class="px-4">Shift</th>
                    <th class="px-4">Hire Date</th>
                    <th class="px-4">Status</th>
                    <th class="px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var initials = ((e.User?.FirstName ?? "N").Substring(0, 1) + (e.User?.LastName ?? "A").Substring(0, 1)).ToUpper();
                    <tr>
                        <td class="px-4"><span class="badge rounded-pill bg-secondary">@initials</span></td>
                        <td class="px-4">@e.EmployeeNumber</td>
                        <td class="px-4">@e.User?.FirstName @e.User?.LastName</td>
                        <td class="px-4">@e.User?.Email</td>
                        <td class="px-4">@(e.Department?.Name ?? "Unassigned")</td>
                        <td class="px-4">@(e.EmploymentType?.ToString() ?? "N/A")</td>
                        <td class="px-4">₱@e.BasicSalary.ToString("N2")</td>
                        <td class="px-4">@(e.Shift?.ShiftName ?? "N/A")</td>
                        <td class="px-4">@e.HireDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">
                            <span class="badge @(e.Status == EmploymentStatus.Active ? "bg-success" : "bg-danger")">
                                @e.Status
                            </span>
                        </td>
                        <td class="px-4">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-controller="Employee" asp-action="Details" asp-route-id="@e.EmployeeId" class="btn btn-outline-info">View</a>
                                <a asp-controller="Employee" asp-action="Edit" asp-route-id="@e.EmployeeId" class="btn btn-outline-warning">Edit</a>
                                <a asp-controller="Payroll" asp-action="Process" class="btn btn-outline-success">Generate Payroll</a>
                                <a asp-controller="Attendance" asp-action="Index" asp-route-employeeId="@e.EmployeeId" class="btn btn-outline-primary">Attendance</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted py-4">No employees found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center px-4 py-3">
    <small class="text-muted">Page @current of @total</small>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="EmployeeReport" asp-route-page="@(current - 1)"
           asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-employmentType="@ViewBag.SelectedEmploymentType" asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

        @if (start > 1)
        {
            <a asp-action="EmployeeReport" asp-route-page="1"
               asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.SelectedDepartment"
               asp-route-employmentType="@ViewBag.SelectedEmploymentType" asp-route-status="@ViewBag.SelectedStatus"
               class="btn btn-sm btn-outline-primary">1</a>
            @if (start > 2) { <span class="px-2">...</span> }
        }

        @for (int i = start; i <= end; i++)
        {
            <a asp-action="EmployeeReport" asp-route-page="@i"
               asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.SelectedDepartment"
               asp-route-employmentType="@ViewBag.SelectedEmploymentType" asp-route-status="@ViewBag.SelectedStatus"
               class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
        }

        @if (end < total)
        {
            @if (end < total - 1) { <span class="px-2">...</span> }
            <a asp-action="EmployeeReport" asp-route-page="@total"
               asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.SelectedDepartment"
               asp-route-employmentType="@ViewBag.SelectedEmploymentType" asp-route-status="@ViewBag.SelectedStatus"
               class="btn btn-sm btn-outline-primary">@total</a>
        }

        <a asp-action="EmployeeReport" asp-route-page="@(current + 1)"
           asp-route-search="@ViewBag.Search" asp-route-department="@ViewBag.SelectedDepartment"
           asp-route-employmentType="@ViewBag.SelectedEmploymentType" asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
    </div>
</div>
