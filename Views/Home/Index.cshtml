@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5 pf-home">

    <!-- HERO -->
    <div class="pf-home-hero text-center">

        <h1 class="display-5 fw-bold">PayFlow Payroll System</h1>
        <p class="lead">Streamline payroll, attendance, and government deductions with ease.</p>

        <div class="mt-4">
            <a class="btn btn-light btn-lg text-success me-2" asp-controller="Account" asp-action="Login">Login</a>
        </div>
    </div>

    <!-- FEATURES -->
    <div class="row mt-5 text-center">
        <div class="col-md-3">
            <div class="card pf-home-feature-card p-4">
                <h5>Employees</h5>
                <p class="text-muted">Manage employee records efficiently.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card pf-home-feature-card p-4">
                <h5>Attendance</h5>
                <p class="text-muted">Track work hours and attendance.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card pf-home-feature-card p-4">
                <h5>Payroll</h5>
                <p class="text-muted">Automate salary calculations.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card pf-home-feature-card p-4">
                <h5>Deductions</h5>
                <p class="text-muted">Handle SSS, PhilHealth, Pag-IBIG.</p>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="pf-home-cta text-center mt-5">
        <h3 class="fw-bold">Start managing your payroll today</h3>
        <p class="text-muted">Simple. Efficient. Reliable.</p>

        <a class="btn btn-success btn-lg mt-3" asp-controller="Account" asp-action="Login">
            Get Started
        </a>
    </div>

</div>
