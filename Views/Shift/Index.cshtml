@model List<itpayroll.Models.Shift>
@{
    ViewData["Title"] = "Shifts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Shifts</h4>
        <small class="text-muted">Manage work shift schedules</small>
    </div>
    <a asp-action="Create" class="btn btn-success">Add Shift</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Shift Name</th>
                    <th class="px-4">Start Time</th>
                    <th class="px-4">End Time</th>
                    <th class="px-4">Grace (min)</th>
                    <th class="px-4">Night</th>
                    <th class="px-4">Overnight</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in Model)
                {
                    <tr>
                        <td class="px-4"><strong>@shift.ShiftName</strong></td>
                        <td class="px-4">@shift.StartTime.ToString(@"hh\:mm")</td>
                        <td class="px-4">@shift.EndTime.ToString(@"hh\:mm")</td>
                        <td class="px-4">@shift.GracePeriodMinutes</td>
                        <td class="px-4">@(shift.IsNightShift ? "Yes" : "No")</td>
                        <td class="px-4">@(shift.IsOvernight ? "Yes" : "No")</td>
                        <td class="px-4">
                            <span class="badge @(shift.IsActive ? "bg-success" : "bg-secondary")">
                                @(shift.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Edit" asp-route-id="@shift.ShiftId" class="btn btn-sm btn-outline-warning">Edit</a>
                            @if (shift.IsActive)
                            {
                                <form asp-action="Delete" asp-route-id="@shift.ShiftId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this shift?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No shifts found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
