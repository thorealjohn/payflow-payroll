@model itpayroll.Models.Shift

@{
    ViewData["Title"] = "Delete Shift";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Delete Shift</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        Are you sure you want to delete this shift?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Shift Name</dt>
                        <dd class="col-sm-8">@Model.ShiftName</dd>

                        <dt class="col-sm-4">Start Time</dt>
                        <dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm")</dd>

                        <dt class="col-sm-4">End Time</dt>
                        <dd class="col-sm-8">@Model.EndTime.ToString(@"hh\:mm")</dd>

                        <dt class="col-sm-4">Grace Period</dt>
                        <dd class="col-sm-8">@Model.GracePeriodMinutes minutes</dd>

                        <dt class="col-sm-4">Night Shift</dt>
                        <dd class="col-sm-8">@(Model.IsNightShift ? "Yes" : "No")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ShiftId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
