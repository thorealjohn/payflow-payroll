@model itpayroll.Models.Shift
@{
    ViewData["Title"] = "Edit Shift";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Edit Shift</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ShiftId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="mb-3">
                        <label asp-for="ShiftName" class="form-label"></label>
                        <input asp-for="ShiftName" class="form-control" />
                        <span asp-validation-for="ShiftName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GracePeriodMinutes" class="form-label"></label>
                        <input asp-for="GracePeriodMinutes" class="form-control" />
                        <span asp-validation-for="GracePeriodMinutes" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input asp-for="IsNightShift" class="form-check-input" />
                                <label asp-for="IsNightShift" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input asp-for="IsOvernight" class="form-check-input" />
                                <label asp-for="IsOvernight" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rest Days</label>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" })
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input rest-day-cb" value="@day" />
                                    <label class="form-check-label">@day</label>
                                </div>
                            }
                        </div>
                        <input type="hidden" asp-for="RestDays" id="RestDays" />
                        <span asp-validation-for="RestDays" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Update Shift</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var hidden = document.getElementById('RestDays');
            var checkboxes = document.querySelectorAll('.rest-day-cb');
            function sync() {
                var vals = [];
                checkboxes.forEach(function (cb) { if (cb.checked) vals.push(cb.value); });
                hidden.value = vals.join(',');
            }
            var initial = hidden.value.split(',').map(function (s) { return s.trim(); });
            checkboxes.forEach(function (cb) {
                cb.checked = initial.indexOf(cb.value) !== -1;
                cb.addEventListener('change', sync);
            });
        });
    </script>
}
