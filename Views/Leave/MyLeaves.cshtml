@model List<itpayroll.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">My Leave Requests</h4>
        <small class="text-muted">View and manage your leave requests</small>
    </div>
    <a asp-action="Create" class="btn btn-success">Request Leave</a>
</div>

@await Html.PartialAsync("_PeriodSelector")

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Leave Type</th>
                    <th class="px-4">Start Date</th>
                    <th class="px-4">End Date</th>
                    <th class="px-4">Days</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="px-4">@l.LeaveType</td>
                        <td class="px-4">@l.StartDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@l.EndDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@l.DaysRequested</td>
                        <td class="px-4">
                            @if (l.Status == itpayroll.Models.LeaveStatus.Pending)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (l.Status == itpayroll.Models.LeaveStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (l.Status == itpayroll.Models.LeaveStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td class="text-end px-4">
                            @if (l.Status == itpayroll.Models.LeaveStatus.Pending)
                            {
                                <form asp-action="Cancel" asp-route-id="@l.LeaveRequestId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this leave request?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No leave requests found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @{
            int current = ViewBag.CurrentPage ?? 1;
            int total = ViewBag.TotalPages ?? 1;
            int start = Math.Max(1, current - 2);
            int end = Math.Min(total, current + 2);
        }
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
            <small class="text-muted">Page @current of @total</small>
            <div class="d-flex gap-1 flex-wrap">
                <a asp-action="MyLeaves" asp-route-page="@(current - 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

                @if (start > 1)
                {
                    <a asp-action="MyLeaves" asp-route-page="1" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">1</a>
                    @if (start > 2) { <span class="px-2">...</span> }
                }

                @for (int i = start; i <= end; i++)
                {
                    <a asp-action="MyLeaves" asp-route-page="@i" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                       class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
                }

                @if (end < total)
                {
                    @if (end < total - 1) { <span class="px-2">...</span> }
                    <a asp-action="MyLeaves" asp-route-page="@total" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">@total</a>
                }

                <a asp-action="MyLeaves" asp-route-page="@(current + 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
            </div>
        </div>
    </div>
</div>
