@model List<itpayroll.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

<div class="mb-4">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1">Leave Requests</h4>
            <small class="text-muted">Manage employee leave requests</small>
        </div>

        <!-- 🔥 STATUS FILTER (RIGHT SIDE like Audit Logs) -->
        <div class="btn-group">
            <a asp-action="Index"
               asp-route-status="@null"
               class="btn btn-sm @(ViewBag.SelectedStatus == null ? "btn-primary" : "btn-outline-primary")">
                All
            </a>

            <a asp-action="Index"
               asp-route-status="Pending"
               class="btn btn-sm @(ViewBag.SelectedStatus?.ToString() == "Pending" ? "btn-warning" : "btn-outline-warning")">
                Pending
            </a>

            <a asp-action="Index"
               asp-route-status="Approved"
               class="btn btn-sm @(ViewBag.SelectedStatus?.ToString() == "Approved" ? "btn-success" : "btn-outline-success")">
                Approved
            </a>

            <a asp-action="Index"
               asp-route-status="Rejected"
               class="btn btn-sm @(ViewBag.SelectedStatus?.ToString() == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                Rejected
            </a>
        </div>
    </div>

    <!-- 🔹 SEARCH + PERIOD (CLEAN ROW) -->
    <form asp-action="Index" method="get"
          class="d-flex flex-wrap gap-2 align-items-center">

        <input type="text"
               name="searchString"
               class="form-control"
               style="max-width: 300px;"
               placeholder="Search by employee name..."
               value="@ViewBag.CurrentFilter" />

        @await Html.PartialAsync("_PeriodSelector")

        @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter) ||
                !string.IsNullOrEmpty(ViewBag.CustomDateFrom) ||
                !string.IsNullOrEmpty(ViewBag.CustomDateTo))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }

    </form>

</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Leave Type</th>
                    <th class="px-4">Start Date</th>
                    <th class="px-4">End Date</th>
                    <th class="px-4">Days</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="px-4">@l.Employee.User?.FirstName @l.Employee.User?.LastName</td>
                        <td class="px-4">@l.LeaveType</td>
                        <td class="px-4">@l.StartDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@l.EndDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@l.DaysRequested</td>
                        <td class="px-4">
                            @if (l.Status == itpayroll.Models.LeaveStatus.Pending)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (l.Status == itpayroll.Models.LeaveStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (l.Status == itpayroll.Models.LeaveStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@l.LeaveRequestId" class="btn btn-sm btn-outline-info">View</a>
                            @if (l.Status == itpayroll.Models.LeaveStatus.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@l.LeaveRequestId" method="post" class="d-inline" onsubmit="return confirm('Approve this leave request?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                </form>
                                <a asp-action="Reject" asp-route-id="@l.LeaveRequestId" class="btn btn-sm btn-outline-danger">Reject</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No leave requests found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
    <small class="text-muted">Page @current of @total</small>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="Index" asp-route-page="@(current - 1)"
           asp-route-status="@ViewBag.SelectedStatus" asp-route-searchString="@ViewBag.CurrentFilter"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

        @if (start > 1)
        {
            <a asp-action="Index" asp-route-page="1"
               asp-route-status="@ViewBag.SelectedStatus" asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">1</a>
            @if (start > 2) { <span class="px-2">...</span> }
        }

        @for (int i = start; i <= end; i++)
        {
            <a asp-action="Index" asp-route-page="@i"
               asp-route-status="@ViewBag.SelectedStatus" asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
        }

        @if (end < total)
        {
            @if (end < total - 1) { <span class="px-2">...</span> }
            <a asp-action="Index" asp-route-page="@total"
               asp-route-status="@ViewBag.SelectedStatus" asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">@total</a>
        }

        <a asp-action="Index" asp-route-page="@(current + 1)"
           asp-route-status="@ViewBag.SelectedStatus" asp-route-searchString="@ViewBag.CurrentFilter"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
    </div>
</div>
