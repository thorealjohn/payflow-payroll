@model List<itpayroll.Models.Overtime>
@using itpayroll.Models

@{
    ViewData["Title"] = "Overtime Management";
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

<div class="mb-4">

    <!-- Row 1: Title + Status Filters -->
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h4 class="fw-bold mb-0">Overtime Management</h4>
            <small class="text-muted">Review and approve employee overtime requests</small>
        </div>

        <div class="btn-group" role="group">
            <a asp-action="Index"
               class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.SelectedStatus) ? "btn-primary" : "btn-outline-primary")">
                All
            </a>

            <a asp-action="Index" asp-route-status="Pending"
               class="btn btn-sm @(ViewBag.SelectedStatus == "Pending" ? "btn-warning" : "btn-outline-warning")">
                Pending
            </a>

            <a asp-action="Index" asp-route-status="Approved"
               class="btn btn-sm @(ViewBag.SelectedStatus == "Approved" ? "btn-success" : "btn-outline-success")">
                Approved
            </a>

            <a asp-action="Index" asp-route-status="Rejected"
               class="btn btn-sm @(ViewBag.SelectedStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                Rejected
            </a>
        </div>
    </div>

    <!-- Row 2: Search + Period -->
    <form method="get" class="d-flex justify-content-between align-items-center gap-2">

        <div class="d-flex gap-2 w-75">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by employee..."
                   value="@ViewBag.CurrentFilter" />

            @await Html.PartialAsync("_PeriodSelector")
        </div>

        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter) ||
                        !string.IsNullOrEmpty(ViewBag.CustomDateFrom) ||
                        !string.IsNullOrEmpty(ViewBag.CustomDateTo))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>

    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Date</th>
                    <th class="px-4">Hours</th>
                    <th class="px-4">Reason</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ot in Model)
                {
                    <tr>
                        <td class="px-4">
                            @ot.Employee?.User?.FirstName @ot.Employee?.User?.LastName
                        </td>

                        <td class="px-4">
                            @ot.Date.ToString("MMM dd, yyyy")
                        </td>

                        <td class="px-4">
                            @if (ot.Hours > 4)
                            {
                                <span class="badge bg-danger">@ot.Hours.ToString("N2")</span>
                            }
                            else
                            {
                                @ot.Hours.ToString("N2")
                            }
                    </td>

                    <td class="px-4">
                        @(string.IsNullOrEmpty(ot.Reason) ? "-" : ot.Reason)
                    </td>

                    <td class="px-4">
                        <span class="badge
                                @(ot.Status == OvertimeStatus.Pending ? "bg-warning text-dark" :
                                                                ot.Status == OvertimeStatus.Approved ? "bg-success" :
                                                                "bg-danger")">
                            @ot.Status
                        </span>
                    </td>

                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@ot.OvertimeId"
                               class="btn btn-sm btn-outline-info">View</a>

                        @if (ot.Status == OvertimeStatus.Pending)
                            {
                                <a asp-action="Edit" asp-route-id="@ot.OvertimeId"
                                   class="btn btn-sm btn-outline-warning">Edit</a>

                                <form asp-action="Approve"
                                      asp-route-id="@ot.OvertimeId"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success"
                                            onclick="return confirm('Approve this overtime?')">
                                        Approve
                                    </button>
                                </form>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="showRejectModal(@ot.OvertimeId)">
                                    Reject
                                </button>
                            }

                            <a asp-action="Delete"
                               asp-route-id="@ot.OvertimeId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-clock-history fs-1"></i>
                                <p class="mt-2 mb-0">No overtime records yet</p>
                                <small>Try adjusting filters or add new overtime</small>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
    <small class="text-muted">Page @current of @total</small>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="Index" asp-route-page="@(current - 1)"
           asp-route-searchString="@ViewBag.CurrentFilter"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

        @if (start > 1)
        {
            <a asp-action="Index" asp-route-page="1"
               asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">1</a>
            @if (start > 2) { <span class="px-2">...</span> }
        }

        @for (int i = start; i <= end; i++)
        {
            <a asp-action="Index" asp-route-page="@i"
               asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
        }

        @if (end < total)
        {
            @if (end < total - 1) { <span class="px-2">...</span> }
            <a asp-action="Index" asp-route-page="@total"
               asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">@total</a>
        }

        <a asp-action="Index" asp-route-page="@(current + 1)"
           asp-route-searchString="@ViewBag.CurrentFilter"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="rejectForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Overtime</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Rejection Reason</label>
                        <textarea name="rejectionReason"
                                  class="form-control"
                                  rows="3"
                                  required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        Reject
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showRejectModal(id) {
            document.getElementById('rejectForm').action = '/Overtime/Reject/' + id;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}