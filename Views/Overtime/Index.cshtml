@model List<itpayroll.Models.Overtime>
@using itpayroll.Models
@{
    ViewData["Title"] = "Overtime Management";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-0">Overtime Management</h4>
            <small class="text-muted">Review and approve employee overtime requests</small>
        </div>
    </div>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <input type="text" name="searchString" class="form-control" placeholder="Search by employee..." value="@ViewBag.CurrentFilter" />
    </div>
    <div class="col-auto">
        <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" placeholder="From Date" />
    </div>
    <div class="col-auto">
        <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" placeholder="To Date" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Date</th>
                    <th class="px-4">Hours</th>
                    <th class="px-4">Reason</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ot in Model)
                {
                    <tr>
                        <td class="px-4">@ot.Employee?.User?.FirstName @ot.Employee?.User?.LastName</td>
                        <td class="px-4">@ot.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@ot.Hours.ToString("N2")</td>
                        <td class="px-4">@(string.IsNullOrEmpty(ot.Reason) ? "-" : ot.Reason)</td>
                        <td class="px-4">
                            <span class="badge @(ot.Status == OvertimeStatus.Pending ? "bg-warning" : ot.Status == OvertimeStatus.Approved ? "bg-success" : "bg-danger")">
                                @ot.Status
                            </span>
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@ot.OvertimeId" class="btn btn-sm btn-outline-info">View</a>
                            @if (ot.Status == OvertimeStatus.Pending)
                            {
                                <a asp-action="Edit" asp-route-id="@ot.OvertimeId" class="btn btn-sm btn-outline-warning">Edit</a>
                                <form asp-action="Approve" asp-route-id="@ot.OvertimeId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Approve this overtime?')">Approve</button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="showRejectModal(@ot.OvertimeId)">Reject</button>
                            }
                            <a asp-action="Delete" asp-route-id="@ot.OvertimeId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No overtime records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="rejectForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Overtime</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Rejection Reason</label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showRejectModal(id) {
            document.getElementById('rejectForm').action = '/Overtime/Reject/' + id;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}
