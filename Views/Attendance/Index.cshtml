@model List<itpayroll.Models.Attendance>
@{
    ViewData["Title"] = "Attendance Records";
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Attendance Records</h4>
        <small class="text-muted">Track employee attendance and working hours</small>
    </div>

    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <a asp-action="Create" class="btn btn-success">Log Attendance</a>
    }
</div>

<!-- FILTER BAR -->
<form method="get" class="d-flex flex-wrap gap-2 align-items-center mb-3">

    <input type="text"
           name="search"
           class="form-control w-auto"
           placeholder="Search employee..."
           style="min-width: 250px;" />

    @await Html.PartialAsync("_PeriodSelector") <!-- MUST NOT contain <form> -->


</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0 table-hover">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Date</th>
                    <th class="px-4">Time In</th>
                    <th class="px-4">Time Out</th>
                    <th class="px-4">Total Hours</th>
                    <th class="px-4">OT Hours</th>
                    <th class="px-4">Night Shift (hrs)</th>
                    <th class="px-4">Day Type</th>
                    <th class="px-4">Late (min)</th>
                    <th class="px-4">Undertime (min)</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var a in Model)
                {
                    var badgeClass = a.DayType switch
                    {
                        itpayroll.Models.DayType.Regular => "bg-secondary",
                        itpayroll.Models.DayType.RestDay => "bg-info",
                        itpayroll.Models.DayType.Holiday => "bg-warning",
                        _ => "bg-danger"
                    };

                    <tr class="@(!a.IsActive ? "table-secondary" : "")">
                        <td class="px-4">@a.Employee.User?.FirstName @a.Employee.User?.LastName</td>
                        <td class="px-4">@a.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@a.TimeIn.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TimeOut.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TotalHours.ToString("N2")</td>
                        <td class="px-4">@a.OvertimeHours.ToString("N2")</td>
                        <td class="px-4">@a.NightShiftHours.ToString("N2")</td>

                        <td class="px-4">
                            <span class="badge @badgeClass">@a.DayType</span>
                        </td>

                        <td class="px-4">
                            @if (a.LateMinutes > 0)
                            {
                                <span class="badge bg-warning">@a.LateMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>

                        <td class="px-4">
                            @if (a.UndertimeMinutes > 0)
                            {
                                <span class="badge bg-danger">@a.UndertimeMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>

                        <td class="px-4">
                            <span class="badge @(a.IsActive ? "bg-success" : "bg-secondary")">@(a.IsActive ? "Active" : "Inactive")</span>
                        </td>

                        <td class="text-end px-4">
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@a.AttendanceId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@a.AttendanceId"
                                   class="btn btn-sm btn-outline-danger">
                                    @(a.IsActive ? "Delete" : "Restore")
                                </a>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="12">
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1"></i>
                                <p class="mt-2 mb-0">No attendance records yet</p>
                                <small>Try adjusting your filters or add new attendance</small>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
    <small class="text-muted">Page @current of @total</small>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="Index" asp-route-page="@(current - 1)"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

        @if (start > 1)
        {
            <a asp-action="Index" asp-route-page="1"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">1</a>
            @if (start > 2) { <span class="px-2">...</span> }
        }

        @for (int i = start; i <= end; i++)
        {
            <a asp-action="Index" asp-route-page="@i"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
        }

        @if (end < total)
        {
            @if (end < total - 1) { <span class="px-2">...</span> }
            <a asp-action="Index" asp-route-page="@total"
               asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
               class="btn btn-sm btn-outline-primary">@total</a>
        }

        <a asp-action="Index" asp-route-page="@(current + 1)"
           asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
           class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
    </div>
</div>