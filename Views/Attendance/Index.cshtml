@model List<itpayroll.Models.Attendance>
@{
    ViewData["Title"] = "Attendance Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Attendance Records</h4>
        <small class="text-muted">Track employee attendance and working hours</small>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
    {
        <a asp-action="Create" class="btn btn-success">+ Log Attendance</a>
    }
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <input type="date" name="date" value="@(ViewBag.SelectedDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Date</th>
                    <th class="px-4">Time In</th>
                    <th class="px-4">Time Out</th>
                    <th class="px-4">Total Hours</th>
                    <th class="px-4">OT Hours</th>
                    <th class="px-4">Night Shift (hrs)</th>
                    <th class="px-4">Day Type</th>
                    <th class="px-4">Late (min)</th>
                    <th class="px-4">Undertime (min)</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="px-4">@a.Employee.User?.FirstName @a.Employee.User?.LastName</td>
                        <td class="px-4">@a.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@a.TimeIn.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TimeOut.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TotalHours.ToString("N2")</td>
                        <td class="px-4">@a.OvertimeHours.ToString("N2")</td>
                        <td class="px-4">@a.NightShiftHours.ToString("N2")</td>
                        <td class="px-4">
                            <span class="badge @(a.DayType == itpayroll.Models.DayType.Regular ? "bg-secondary" : a.DayType == itpayroll.Models.DayType.RestDay ? "bg-info" : a.DayType == itpayroll.Models.DayType.Holiday ? "bg-warning" : "bg-danger")">
                                @a.DayType
                            </span>
                        </td>
                        <td class="px-4">
                            @if (a.LateMinutes > 0)
                            {
                                <span class="badge bg-warning">@a.LateMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>
                        <td class="px-4">
                            @if (a.UndertimeMinutes > 0)
                            {
                                <span class="badge bg-danger">@a.UndertimeMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Edit" asp-route-id="@a.AttendanceId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@a.AttendanceId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted py-4">No attendance records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
