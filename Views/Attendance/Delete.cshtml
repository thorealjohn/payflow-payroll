@model itpayroll.Models.Attendance
@{
    ViewData["Title"] = "Delete Attendance";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Delete Attendance Record</h4>
    <small class="text-muted">This action cannot be undone</small>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete this attendance record?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@Model.Employee.User?.FirstName @Model.Employee.User?.LastName</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3">Time In</dt>
            <dd class="col-sm-9">@Model.TimeIn.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3">Time Out</dt>
            <dd class="col-sm-9">@Model.TimeOut.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3">Total Hours</dt>
            <dd class="col-sm-9">@Model.TotalHours.ToString("N2")</dd>

            <dt class="col-sm-3">Overtime Hours</dt>
            <dd class="col-sm-9">@Model.OvertimeHours.ToString("N2")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="AttendanceId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
