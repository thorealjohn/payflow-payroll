@model List<itpayroll.Models.Attendance>
@{
    ViewData["Title"] = "My Attendance";
}

<h2>My Attendance</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th>Total Hours</th>
            <th>OT Hours</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Date.ToString("MMM dd, yyyy")</td>
                <td>@a.TimeIn.ToString(@"hh\:mm")</td>
                <td>@a.TimeOut.ToString(@"hh\:mm")</td>
                <td>@a.TotalHours.ToString("N2")</td>
                <td>@a.OvertimeHours.ToString("N2")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No attendance records found.</td>
            </tr>
        }
    </tbody>
</table>
