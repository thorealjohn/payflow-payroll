@model List<itpayroll.Models.Attendance>
@{
    ViewData["Title"] = "My Attendance";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">My Attendance</h4>
    <small class="text-muted">View and log your attendance</small>
</div>

@await Html.PartialAsync("_PeriodSelector")

<div class="mb-3 d-flex gap-2">
    <form asp-action="TimeIn" method="post" style="display:inline;">
        <button type="submit" class="btn btn-success" onclick="return confirm('Record Time In now?')">
            <i class="fas fa-sign-in-alt me-2"></i>Time In
        </button>
    </form>
    <form asp-action="TimeOut" method="post" style="display:inline;">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Record Time Out now?')">
            <i class="fas fa-sign-out-alt me-2"></i>Time Out
        </button>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Date</th>
                    <th class="px-4">Time In</th>
                    <th class="px-4">Time Out</th>
                    <th class="px-4">Total Hours</th>
                    <th class="px-4">OT Hours</th>
                    <th class="px-4">Late (min)</th>
                    <th class="px-4">Undertime (min)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="px-4">@a.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">@a.TimeIn.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TimeOut.ToString(@"hh\:mm")</td>
                        <td class="px-4">@a.TotalHours.ToString("N2")</td>
                        <td class="px-4">@a.OvertimeHours.ToString("N2")</td>
                        <td class="px-4">
                            @if (a.LateMinutes > 0)
                            {
                                <span class="badge bg-warning">@a.LateMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>
                        <td class="px-4">
                            @if (a.UndertimeMinutes > 0)
                            {
                                <span class="badge bg-danger">@a.UndertimeMinutes</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No attendance records found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @{
            int current = ViewBag.CurrentPage ?? 1;
            int total = ViewBag.TotalPages ?? 1;
            int start = Math.Max(1, current - 2);
            int end = Math.Min(total, current + 2);
        }
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
            <small class="text-muted">Page @current of @total</small>
            <div class="d-flex gap-1 flex-wrap">
                <a asp-action="MyAttendance" asp-route-page="@(current - 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

                @if (start > 1)
                {
                    <a asp-action="MyAttendance" asp-route-page="1" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">1</a>
                    @if (start > 2) { <span class="px-2">...</span> }
                }

                @for (int i = start; i <= end; i++)
                {
                    <a asp-action="MyAttendance" asp-route-page="@i" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                       class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
                }

                @if (end < total)
                {
                    @if (end < total - 1) { <span class="px-2">...</span> }
                    <a asp-action="MyAttendance" asp-route-page="@total" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">@total</a>
                }

                <a asp-action="MyAttendance" asp-route-page="@(current + 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
            </div>
        </div>
    </div>
</div>
