@model itpayroll.ViewModels.AttendanceViewModel
@{
    ViewData["Title"] = "Edit Attendance";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Edit Attendance</h4>
    <small class="text-muted">Update attendance record</small>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="AttendanceId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Employee</label>
                <select class="form-select" disabled asp-items="ViewBag.Employees">
                    <option value="">-- Select Employee --</option>
                </select>
                <input type="hidden" asp-for="EmployeeId" />
            </div>

            <div class="mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" type="date" readonly />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="TimeIn" class="form-label"></label>
                    <input asp-for="TimeIn" class="form-control" type="time" />
                    <span asp-validation-for="TimeIn" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="TimeOut" class="form-label"></label>
                    <input asp-for="TimeOut" class="form-control" type="time" />
                    <span asp-validation-for="TimeOut" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="OvertimeHours" class="form-label"></label>
                    <input asp-for="OvertimeHours" class="form-control" type="number" step="0.5" min="0" max="24" />
                    <span asp-validation-for="OvertimeHours" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DayType" class="form-label"></label>
                    <select asp-for="DayType" class="form-select" asp-items="Html.GetEnumSelectList<itpayroll.Models.DayType>()"></select>
                    <span asp-validation-for="DayType" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to Records</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
