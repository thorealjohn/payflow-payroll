@model itpayroll.ViewModels.PayrollDetailViewModel
@{
    ViewData["Title"] = "My Payslip";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">My Payslip</h4>
    <small class="text-muted">View your salary breakdown</small>
</div>

<div class="card mb-4">
    <div class="card-header bg-light">
        <div class="row">
            <div class="col">
                <strong>Period:</strong> @Model.Payroll.PeriodStart.ToString("MMM dd") - @Model.Payroll.PeriodEnd.ToString("MMM dd, yyyy")
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Earnings</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        @foreach (var e in Model.Earnings)
                        {
                            <tr>
                                <td>@e.Type</td>
                                <td class="text-end">₱@e.Amount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="table-success">
                            <td><strong>Gross Pay</strong></td>
                            <td class="text-end"><strong>₱@Model.Payroll.GrossPay.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Deductions</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        @foreach (var d in Model.Deductions)
                        {
                            <tr>
                                <td>@d.Type</td>
                                <td class="text-end">₱@d.Amount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="table-danger">
                            <td><strong>Total Deductions</strong></td>
                            <td class="text-end"><strong>₱@Model.Payroll.TotalDeductions.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="row text-center">
            <div class="col">
                <h5>Gross Pay</h5>
                <h3 class="text-success">₱@Model.Payroll.GrossPay.ToString("N2")</h3>
            </div>
            <div class="col">
                <h5>Total Deductions</h5>
                <h3 class="text-danger">₱@Model.Payroll.TotalDeductions.ToString("N2")</h3>
            </div>
            <div class="col">
                <h5>Net Pay</h5>
                <h3 class="text-primary">₱@Model.Payroll.NetPay.ToString("N2")</h3>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <span class="badge @(Model.Payroll.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : "bg-primary") fs-6">
        Status: @Model.Payroll.Status
    </span>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="MyPayslips" class="btn btn-secondary">Back to My Payslips</a>
    <button onclick="window.print()" class="btn btn-outline-primary">
        <i class="fas fa-print me-2"></i>Print / Download PDF
    </button>
</div>
