@model List<itpayroll.ViewModels.PayrollDetailViewModel>
@{
    ViewData["Title"] = "My Payslips";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">My Payslips</h4>
    <small class="text-muted">View your salary payslips</small>
</div>

@await Html.PartialAsync("_PeriodSelector")

<div class="card">
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach (var item in Model)
            {
                var statusBadge = item.Payroll.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : "bg-primary";
                <a asp-action="MyPayslip" asp-route-id="@item.Payroll.PayrollId" class="list-group-item list-group-item-action px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@item.Payroll.PeriodStart.ToString("MMM dd") - @item.Payroll.PeriodEnd.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div>
                            <span class="badge @statusBadge me-2">@item.Payroll.Status</span>
                            <strong class="text-primary">₱@item.Payroll.NetPay.ToString("N2")</strong>
                        </div>
                    </div>
                </a>
            }
            @if (!Model.Any())
            {
                <div class="list-group-item text-center text-muted py-4">No payslip records found.</div>
            }
        </div>

        @{
            int current = ViewBag.CurrentPage ?? 1;
            int total = ViewBag.TotalPages ?? 1;
            int start = Math.Max(1, current - 2);
            int end = Math.Min(total, current + 2);
        }
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
            <small class="text-muted">Page @current of @total</small>
            <div class="d-flex gap-1 flex-wrap">
                <a asp-action="MyPayslips" asp-route-page="@(current - 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">Previous</a>

                @if (start > 1)
                {
                    <a asp-action="MyPayslips" asp-route-page="1" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">1</a>
                    @if (start > 2) { <span class="px-2">...</span> }
                }

                @for (int i = start; i <= end; i++)
                {
                    <a asp-action="MyPayslips" asp-route-page="@i" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                       class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">@i</a>
                }

                @if (end < total)
                {
                    @if (end < total - 1) { <span class="px-2">...</span> }
                    <a asp-action="MyPayslips" asp-route-page="@total" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo" class="btn btn-sm btn-outline-primary">@total</a>
                }

                <a asp-action="MyPayslips" asp-route-page="@(current + 1)" asp-route-period="@ViewBag.Period" asp-route-customDateFrom="@ViewBag.CustomDateFrom" asp-route-customDateTo="@ViewBag.CustomDateTo"
                   class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">Next</a>
            </div>
        </div>
    </div>
</div>
