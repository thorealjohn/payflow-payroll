@model itpayroll.ViewModels.PayrollProcessViewModel
@{
    ViewData["Title"] = "Process Payroll";
}

<h2>Process Payroll</h2>

<div class="alert alert-info">
    This will compute salary based on attendance records within the selected period,
    apply government deductions (SSS, PhilHealth, Pag-IBIG), and BIR tax.
</div>

<form asp-action="Process" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
            <option value="">-- Select Employee --</option>
        </select>
        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PeriodStart" class="form-label"></label>
            <input asp-for="PeriodStart" class="form-control" type="date" />
            <span asp-validation-for="PeriodStart" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="PeriodEnd" class="form-label"></label>
            <input asp-for="PeriodEnd" class="form-control" type="date" />
            <span asp-validation-for="PeriodEnd" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Process Payroll</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
