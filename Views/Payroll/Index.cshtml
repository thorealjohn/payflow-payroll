@model List<itpayroll.Models.Payroll>
@{
    ViewData["Title"] = "Payroll Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Payroll Records</h4>
        <small class="text-muted">Manage employee payroll and compensation</small>
        
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {
        <a asp-action="Process" class="btn btn-success">Process Payroll</a>
    }
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <small>Total Net Pay</small>
            <h5 class="fw-bold text-success">₱@ViewBag.TotalNet</h5>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <small>Processed</small>
            <h5 class="fw-bold text-primary">@ViewBag.ProcessedCount</h5>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <small>Released</small>
            <h5 class="fw-bold text-success">@ViewBag.ReleasedCount</h5>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-sm @(ViewBag.Status == null ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="Index" asp-route-status="Draft" class="btn btn-sm btn-outline-secondary">Draft</a>
        <a asp-action="Index" asp-route-status="Processed" class="btn btn-sm btn-outline-primary">Processed</a>
        <a asp-action="Index" asp-route-status="Released" class="btn btn-sm btn-outline-success">Released</a>
    </div>
</div>

<form method="get" class="d-flex flex-wrap gap-2 align-items-center mb-3">

    <input type="text"
           name="searchString"
           class="form-control w-auto"
           placeholder="Search employee name/number..."
           style="min-width: 250px;"
           value="@ViewBag.CurrentFilter" />

    @await Html.PartialAsync("_PeriodSelector")

</form>



<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Employee</th>
                    <th class="px-4">Period</th>
                    <th class="px-4">Gross Pay</th>
                    <th class="px-4">Deductions</th>
                    <th class="px-4">Net Pay</th>
                    <th class="px-4">Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var statusBadge = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : p.Status == itpayroll.Models.PayrollStatus.Processed ? "bg-primary" : "bg-secondary";
                    <tr>
                        <td class="px-4">@p.Employee.User?.FirstName @p.Employee.User?.LastName</td>
                        <td class="px-4">@p.PeriodStart.ToString("MMM dd") - @p.PeriodEnd.ToString("MMM dd, yyyy")</td>
                        <td class="px-4">₱@p.GrossPay.ToString("N2")</td>
                        <td class="px-4">₱@p.TotalDeductions.ToString("N2")</td>
                        <td class="px-4"><strong>₱@p.NetPay.ToString("N2")</strong></td>
                        <td class="px-4"><span class="badge @statusBadge">@p.Status</span></td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@p.PayrollId" class="btn btn-sm btn-outline-info">View</a>
                            @if (p.Status == itpayroll.Models.PayrollStatus.Processed)
                            {
                                <a asp-action="Release" asp-route-id="@p.PayrollId" class="btn btn-sm btn-outline-success">Release</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No payroll records found.</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
