@using itpayroll.Utilities
@model itpayroll.ViewModels.ProfileViewModel
@using itpayroll.Areas.Identity.Data

@{
    ViewData["Title"] = "My Profile";
    var user = ViewBag.User as ApplicationUser;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <!-- Profile Picture Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Profile Picture</h5>
                </div>
                <div class="card-body text-center">
                    <img src="@(user?.ProfilePicturePath ?? "/images/default-profile.png")"
                         class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                    <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
                        <input type="file" name="file" accept="image/*" class="form-control mb-2" />
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </form>
                </div>
            </div>

            <!-- Personal Information (Employee-Editable) -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="MiddleName" class="form-label"></label>
                                    <input asp-for="MiddleName" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="Suffix" class="form-label"></label>
                                    <input asp-for="Suffix" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="DateOfBirth" class="form-label"></label>
                                    <input asp-for="DateOfBirth" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Gender" class="form-label"></label>
                                    <input value="@user?.Gender?.ToString()" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CivilStatus" class="form-label"></label>
                                    <input value="@user?.CivilStatus?.ToString()" class="form-control" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AlternatePhone" class="form-label"></label>
                            <input asp-for="AlternatePhone" class="form-control" />
                        </div>

                        <hr />
                        <h6 class="mb-3">Address</h6>

                        <div class="mb-3">
                            <label asp-for="AddressStreet" class="form-label"></label>
                            <input asp-for="AddressStreet" class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="AddressBarangay" class="form-label"></label>
                                    <input asp-for="AddressBarangay" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="AddressCity" class="form-label"></label>
                                    <input asp-for="AddressCity" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="AddressProvince" class="form-label"></label>
                                    <input asp-for="AddressProvince" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="AddressZipCode" class="form-label"></label>
                                    <input asp-for="AddressZipCode" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <hr />
                        <h6 class="mb-3">Emergency Contact</h6>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="EmergencyContactName" class="form-label"></label>
                                    <input asp-for="EmergencyContactName" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="EmergencyContactRelationship" class="form-label"></label>
                                    <input asp-for="EmergencyContactRelationship" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="EmergencyContactPhone" class="form-label"></label>
                                    <input asp-for="EmergencyContactPhone" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
                            <button type="submit" class="btn btn-primary">Update Profile</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Employment Information (HR/Admin Editable, Employee Read-Only) -->
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Employment Information</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="EditEmployee" method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="EmployeeNumber" class="form-label"></label>
                                        <input asp-for="EmployeeNumber" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DepartmentId" class="form-label"></label>
                                        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments" id="deptSelect">
                                            <option value="">-- Select Department --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PositionId" class="form-label"></label>
                                        <select asp-for="PositionId" class="form-control" asp-items="ViewBag.Positions" id="posSelect">
                                            <option value="">-- Select Position --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="EmploymentType" class="form-label"></label>
                                        <select asp-for="EmploymentType" class="form-control">
                                            <option value="">Select...</option>
                                            <option value="0">Regular</option>
                                            <option value="1">Contractual</option>
                                            <option value="2">Probationary</option>
                                            <option value="3">PartTime</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="BasicSalary" class="form-label"></label>
                                        <input asp-for="BasicSalary" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="SalaryType" class="form-label"></label>
                                        <select asp-for="SalaryType" class="form-control">
                                            <option value="0">Monthly</option>
                                            <option value="1">Daily</option>
                                            <option value="2">Hourly</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="HireDate" class="form-label"></label>
                                        <input asp-for="HireDate" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="BankName" class="form-label"></label>
                                        <input asp-for="BankName" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="BankAccountNumber" class="form-label"></label>
                                        <input asp-for="BankAccountNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="TIN" class="form-label"></label>
                                        <input asp-for="TIN" class="form-control" placeholder="XXX-XXX-XXX" maxlength="15" data-gov-type="tin" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="SSSNumber" class="form-label"></label>
                                        <input asp-for="SSSNumber" class="form-control" placeholder="XX-XXXXXXX-X" maxlength="12" data-gov-type="sss" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="PhilHealthNumber" class="form-label"></label>
                                        <input asp-for="PhilHealthNumber" class="form-control" placeholder="XX-XXXXXXXXX-X" maxlength="14" data-gov-type="philhealth" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="PagIBIGNumber" class="form-label"></label>
                                        <input asp-for="PagIBIGNumber" class="form-control" placeholder="XXXX-XXXX-XXXX" maxlength="14" data-gov-type="pagibig" />
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Update Employment Info</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Employment Information</h5>
                        <span class="badge bg-info">Read Only</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EmployeeNumber" class="form-label"></label>
                                    <input asp-for="EmployeeNumber" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Account Status</label>
                                    <input class="form-control" disabled value="@(user?.IsActive == true ? "Active" : "Inactive")" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Department" class="form-label"></label>
                                    <input asp-for="Department" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Position" class="form-label"></label>
                                    <input asp-for="Position" class="form-control" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EmploymentType" class="form-label"></label>
                                    <input asp-for="EmploymentType" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BasicSalary" class="form-label"></label>
                                    <input asp-for="BasicSalary" class="form-control" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="SalaryType" class="form-label"></label>
                                    <input asp-for="SalaryType" class="form-control" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="HireDate" class="form-label"></label>
                                    <input asp-for="HireDate" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ShiftName" class="form-label"></label>
                                    <input asp-for="ShiftName" class="form-control" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BankAccountNumber" class="form-label"></label>
                                    <input class="form-control" disabled value="@DisplayHelper.MaskAccountNumber(Model.BankAccountNumber)" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">TIN</label>
                                    <input class="form-control" disabled value="@DisplayHelper.MaskAccountNumber(Model.TIN)" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">SSS Number</label>
                                    <input class="form-control" disabled value="@DisplayHelper.MaskAccountNumber(Model.SSSNumber)" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">PhilHealth Number</label>
                                    <input class="form-control" disabled value="@DisplayHelper.MaskAccountNumber(Model.PhilHealthNumber)" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Pag-IBIG Number</label>
                                    <input class="form-control" disabled value="@DisplayHelper.MaskAccountNumber(Model.PagIBIGNumber)" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Last Login</label>
                                    <input class="form-control" disabled value="@(user?.LastLoginDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "Never")" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Password Last Changed</label>
                                    <input class="form-control" disabled value="@(user?.PasswordLastChanged?.ToString("MMM dd, yyyy hh:mm tt") ?? "Never")" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Account Security</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Change your account password using the button below.</p>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="fas fa-key me-2"></i>Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deptSelect = document.getElementById('deptSelect');
            var posSelect = document.getElementById('posSelect');

            if (deptSelect && posSelect) {
                deptSelect.addEventListener('change', function () {
                    var deptId = this.value;
                    posSelect.innerHTML = '<option value="">-- Select Position --</option>';
                    posSelect.disabled = true;
                    if (!deptId) return;

                    fetch('@Url.Action("GetPositionsByDepartment", "Employee")?departmentId=' + deptId)
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            data.forEach(function (p) {
                                var opt = document.createElement('option');
                                opt.value = p.positionId;
                                opt.text = p.name;
                                posSelect.appendChild(opt);
                            });
                            posSelect.disabled = false;
                        });
                });
            }

            document.querySelectorAll('[data-gov-type]').forEach(function (el) {
                if (el.value) {
                    var event = new Event('input', { bubbles: true });
                    el.dispatchEvent(event);
                }
            });
        });
    </script>
}
