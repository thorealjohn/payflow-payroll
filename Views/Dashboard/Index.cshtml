@{
    Layout = "_DashboardLayout";
}

<h2>Dashboard</h2>

@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Employees</h5>
                    <h2 class="display-6">@ViewBag.TotalEmployees</h2>
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-light mt-2">View All</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Today's Attendance</h5>
                    <h2 class="display-6">@ViewBag.TodayAttendance</h2>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-light mt-2">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Payrolls</h5>
                    <h2 class="display-6">@ViewBag.TotalPayrolls</h2>
                    <a asp-controller="Payroll" asp-action="Index" class="btn btn-sm btn-light mt-2">View All</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">Pending Release</h5>
                    <h2 class="display-6">@ViewBag.PendingPayrolls</h2>
                    <a asp-controller="Payroll" asp-action="Index" class="btn btn-sm btn-dark mt-2">Review</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Total Net Pay Released</h5>
                </div>
                <div class="card-body">
                    <h2 class="text-success">₱@(((decimal)ViewBag.TotalPayrollAmount).ToString("N2"))</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Payrolls</h5>
                    <a asp-controller="Payroll" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Net Pay</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls)
                            {
                                var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : p.Status == itpayroll.Models.PayrollStatus.Processed ? "bg-primary" : "bg-secondary";
                                <tr>
                                    <td>@p.Employee.User?.FirstName @p.Employee.User?.LastName</td>
                                    <td>₱@p.NetPay.ToString("N2")</td>
                                    <td><span class="badge @badgeClass">@p.Status</span></td>
                                </tr>
                            }
                            @if (!((List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls).Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted">No payroll records yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Attendance</h5>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in (List<itpayroll.Models.Attendance>)ViewBag.RecentAttendances)
                            {
                                <tr>
                                    <td>@a.Employee.User?.FirstName @a.Employee.User?.LastName</td>
                                    <td>@a.Date.ToString("MMM dd")</td>
                                    <td>@a.TotalHours.ToString("N2") hrs</td>
                                </tr>
                            }
                            @if (!((List<itpayroll.Models.Attendance>)ViewBag.RecentAttendances).Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted">No attendance records yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var employee = ViewBag.Employee as itpayroll.Models.Employee;
    if (employee != null)
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Total Net Pay (All Time)</h5>
                        <h2 class="display-6">₱@((decimal)ViewBag.TotalNetPay).ToString("N2")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h5 class="card-title">My Employee #</h5>
                        <h2 class="display-6">@employee.EmployeeNumber</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5 class="card-title">Status</h5>
                        <h2 class="display-6">@employee.Status</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Payslips</h5>
                        <a asp-controller="Payroll" asp-action="MyPayslips" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Net Pay</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls)
                                {
                                    var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : "bg-primary";
                                    <tr>
                                        <td>@p.PeriodStart.ToString("MMM dd") - @p.PeriodEnd.ToString("MMM dd")</td>
                                        <td>₱@p.NetPay.ToString("N2")</td>
                                        <td><span class="badge @badgeClass">@p.Status</span></td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls).Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No payslip records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Attendance</h5>
                        <a asp-controller="Attendance" asp-action="MyAttendance" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time In</th>
                                    <th>Time Out</th>
                                    <th>Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in (List<itpayroll.Models.Attendance>)ViewBag.MyAttendance)
                                {
                                    <tr>
                                        <td>@a.Date.ToString("MMM dd")</td>
                                        <td>@a.TimeIn.ToString(@"hh\:mm")</td>
                                        <td>@a.TimeOut.ToString(@"hh\:mm")</td>
                                        <td>@a.TotalHours.ToString("N2")</td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Attendance>)ViewBag.MyAttendance).Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No attendance records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Employee profile not found. Please contact your HR administrator.
        </div>
    }
}
