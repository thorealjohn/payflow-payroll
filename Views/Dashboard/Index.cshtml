@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Dashboard</h2>
    @await Html.PartialAsync("_PeriodSelector")
</div>

@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
{
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card kpi-card dashboard-accent-kpi kpi-employees h-100">
                <div class="card-body">
                    <div class="kpi-label"><i class="fas fa-users me-2"></i>Total Employees</div>
                    <div class="kpi-value mt-2">@ViewBag.TotalEmployees</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card dashboard-accent-kpi kpi-attendance h-100">
                <div class="card-body">
                    <div class="kpi-label"><i class="fas fa-user-check me-2"></i>Employees Present Today</div>
                    <div class="kpi-value mt-2">@ViewBag.TodayAttendance</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card dashboard-accent-kpi kpi-alert h-100">
                <div class="card-body">
                    <div class="kpi-label"><i class="fas fa-hourglass-half me-2"></i>Pending Payrolls</div>
                    <div class="kpi-value mt-2">@ViewBag.PendingPayrolls</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card dashboard-accent-kpi kpi-finance h-100">
                <div class="card-body">
                    <div class="kpi-label"><i class="fas fa-coins me-2"></i>Monthly Payroll Expense</div>
                    <div class="kpi-value mt-2">₱@(((decimal)ViewBag.MonthlyPayrollExpense).ToString("N2"))</div>
                </div>
            </div>
        </div>

    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Payrolls</h5>
                    <a asp-controller="Payroll" asp-action="Index" class="small text-success fw-semibold">View All</a>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Pay Period</th>
                                <th>Net Pay</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls)
                            {
                                var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" :
                                    p.Status == itpayroll.Models.PayrollStatus.Processed ? "text-dark bg-warning" :
                                    p.Status == itpayroll.Models.PayrollStatus.PendingApproval ? "bg-warning" :
                                    p.Status == itpayroll.Models.PayrollStatus.Approved ? "bg-info" : "bg-secondary";
                                <tr>
                                    <td>@p.Employee.User?.FirstName @p.Employee.User?.LastName</td>
                                    <td>@p.PeriodStart.ToString("MMM d") - @p.PeriodEnd.ToString("MMM d")</td>
                                    <td>₱@p.NetPay.ToString("N2")</td>
                                    <td><span class="badge @badgeClass">@p.Status</span></td>
                                    <td>
                                        <a asp-controller="Payroll" asp-action="Details" asp-route-id="@p.PayrollId" class="btn btn-sm btn-outline-info">
                                            View Payslip
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!((List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls).Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No payroll records yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Operational Alerts</h5>
                    <span class="badge bg-danger-subtle text-danger-emphasis">@((int)ViewBag.PendingPayrolls + (int)ViewBag.OpenAttendanceCount)</span>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0 small">
                        @if (ViewBag.IncompleteAttendanceEmployee != null)
                        {
                            <li class="mb-2 d-flex align-items-start">
                                <i class="fas fa-exclamation-triangle text-warning me-2 mt-1"></i>
                                <span>@ViewBag.IncompleteAttendanceEmployee has incomplete attendance.</span>
                            </li>
                        }
                        @if ((int)ViewBag.PendingPayrolls > 0)
                        {
                            <li class="mb-2 d-flex align-items-start">
                                <i class="fas fa-file-signature text-danger me-2 mt-1"></i>
                                <span>@ViewBag.PendingPayrolls pending payroll approval(s).</span>
                            </li>
                        }
                        @if ((int)ViewBag.OpenAttendanceCount > 0)
                        {
                            <li class="mb-2 d-flex align-items-start">
                                <i class="fas fa-user-clock text-primary me-2 mt-1"></i>
                                <span>@ViewBag.OpenAttendanceCount employee(s) missing timeout today.</span>
                            </li>
                        }
                        @if (ViewBag.IncompleteAttendanceEmployee == null && (int)ViewBag.PendingPayrolls == 0 && (int)ViewBag.OpenAttendanceCount == 0)
                        {
                            <li class="text-muted">No urgent operational alerts right now.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Monthly Payroll Trend</h5>
                </div>
                <div class="card-body">
                    @if ((bool)ViewBag.ShowPayrollChart)
                    {
                        <canvas id="payrollChart" style="max-height: 280px;"></canvas>
                    }
                    else
                    {
                        <div class="text-muted small mb-2">Not enough points for a trend chart yet. Showing latest monthly totals instead.</div>
                        <table class="table table-sm table-borderless mb-0">
                            <thead><tr><th>Month</th><th class="text-end">Amount</th></tr></thead>
                            <tbody id="payrollFallbackBody"></tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">Upcoming Payroll Schedule</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.UpcomingPayrollDate != null)
                    {
                        <div class="mb-2 text-muted small">Next Payroll Release</div>
                        <div class="h4 mb-3">@(((DateTime)ViewBag.UpcomingPayrollDate).ToString("MMM dd, yyyy"))</div>
                        <div class="small mb-2"><strong>Employees Included:</strong> @ViewBag.UpcomingPayrollEmployees</div>
                        <div class="small"><strong>Estimated Total:</strong> ₱@(((decimal)ViewBag.UpcomingPayrollEstimate).ToString("N2"))</div>
                    }
                    else
                    {
                        <div class="text-muted small">No upcoming unreleased payroll schedule found.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Attendance Trend</h5>
                </div>
                <div class="card-body">
                    @if ((bool)ViewBag.ShowAttendanceChart)
                    {
                        <canvas id="attendanceChart" style="max-height: 260px;"></canvas>
                    }
                    else
                    {
                        <div class="text-muted small mb-2">Attendance trend appears once enough daily records are available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // Payroll Trends Chart
            var payrollData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MonthlyPayroll));
            var payrollCanvas = document.getElementById('payrollChart');
            if (payrollCanvas) {
                var payrollCtx = payrollCanvas.getContext('2d');
                var payrollChart = new Chart(payrollCtx, {
                    type: 'line',
                    data: {
                        labels: payrollData.map(x => x.Month),
                        datasets: [{
                            label: 'Total Net Pay',
                            data: payrollData.map(x => x.Total),
                            borderColor: '#7c3aed',
                            backgroundColor: 'rgba(124, 58, 237, 0.12)',
                            tension: 0.35,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            } else {
                var fallbackBody = document.getElementById('payrollFallbackBody');
                if (fallbackBody) {
                    payrollData.slice(-6).forEach(function (item) {
                        var row = document.createElement('tr');
                        row.innerHTML = '<td>' + item.Month + '</td><td class="text-end">₱' + Number(item.Total).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</td>';
                        fallbackBody.appendChild(row);
                    });
                }
            }

            // Attendance Trends Chart
            var attendanceData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AttendanceTrend));
            var attendanceCanvas = document.getElementById('attendanceChart');
            if (attendanceCanvas) {
                var attendanceCtx = attendanceCanvas.getContext('2d');
                var attendanceChart = new Chart(attendanceCtx, {
                    type: 'line',
                    data: {
                        labels: attendanceData.map(x => new Date(x.Date).toLocaleDateString()),
                        datasets: [{
                            label: 'Attendance Count',
                            data: attendanceData.map(x => x.Count),
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.15)',
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
        </script>
    }
}
else
{
    var employee = ViewBag.Employee as itpayroll.Models.Employee;
    if (employee != null)
    {
        // Summary Cards (green-first styling; status via text color)
        <div class="row g-3 mb-4">
            @{
                var todayStatus = ViewBag.TodayAttendanceStatus as string;
                var statusTextClass = todayStatus == "Present" ? "text-success" :
                    todayStatus == "Late" ? "text-warning" : "text-danger";
                var latestNet = (decimal?)(ViewBag.LatestNetPay) ?? 0m;
                var latestNetDisplay = ViewBag.LatestNetPay != null ? ("₱" + latestNet.ToString("N2")) : "—";
            }

            @* Today's Attendance *@
            <div class="col-md-3">
                <div class="card kpi-card dashboard-accent-kpi h-100">
                    <div class="card-body">
                        <div class="kpi-label"><i class="fas fa-calendar-day me-2 text-success"></i>Today's Attendance</div>
                        <div class="kpi-value mt-2 @statusTextClass">@todayStatus</div>
                    </div>
                </div>
            </div>

            @* This month hours *@
            <div class="col-md-3">
                <div class="card kpi-card dashboard-accent-kpi h-100">
                    <div class="card-body">
                        <div class="kpi-label"><i class="fas fa-clock me-2 text-success"></i>This Month Hours</div>
                        <div class="kpi-value mt-2">@(((decimal)ViewBag.MonthHoursWorked).ToString("N2")) hrs</div>
                    </div>
                </div>
            </div>

            @* Pending requests *@
            <div class="col-md-3">
                <div class="card kpi-card dashboard-accent-kpi h-100">
                    <div class="card-body">
                        <div class="kpi-label"><i class="fas fa-tasks me-2 text-success"></i>Pending Requests</div>
                        <div class="kpi-value mt-2">@ViewBag.PendingRequestsCount</div>
                    </div>
                </div>
            </div>

            @* Latest net pay *@
            <div class="col-md-3">
                <div class="card kpi-card dashboard-accent-kpi h-100">
                    <div class="card-body">
                        <div class="kpi-label"><i class="fas fa-money-bill me-2 text-success"></i>Latest Net Pay</div>
                        <div class="kpi-value mt-2">@latestNetDisplay</div>
                    </div>
                </div>
            </div>
        </div>

        @* Quick Actions *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        <form asp-controller="Attendance" asp-action="TimeIn" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-success" onclick="return confirm('Record Time In now?')">
                                <i class="fas fa-sign-in-alt me-2"></i>Time In
                            </button>
                        </form>
                        <form asp-controller="Attendance" asp-action="TimeOut" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Record Time Out now?')">
                                <i class="fas fa-sign-out-alt me-2"></i>Time Out
                            </button>
                        </form>
                        <a asp-controller="Overtime" asp-action="MyOvertime" class="btn btn-outline-success">
                            <i class="fas fa-business-time me-2"></i>Request Overtime
                        </a>
                        <a asp-controller="Leave" asp-action="Create" class="btn btn-outline-success">
                            <i class="fas fa-file-medical me-2"></i>File Leave
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Recent Activity *@
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Payslips</h5>
                        <a asp-controller="Payroll" asp-action="MyPayslips" class="small text-success fw-semibold">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Net Pay</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls)
                                {
                                    var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" :
                                        p.Status == itpayroll.Models.PayrollStatus.Processed ? "text-dark bg-warning" :
                                        p.Status == itpayroll.Models.PayrollStatus.PendingApproval ? "bg-warning" :
                                        p.Status == itpayroll.Models.PayrollStatus.Approved ? "bg-info" : "bg-secondary";
                                    <tr>
                                        <td>@p.PeriodStart.ToString("MMM dd") - @p.PeriodEnd.ToString("MMM dd")</td>
                                        <td>₱@p.NetPay.ToString("N2")</td>
                                        <td><span class="badge @badgeClass">@p.Status</span></td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls).Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No payslip records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Attendance</h5>
                        <a asp-controller="Attendance" asp-action="MyAttendance" class="small text-success fw-semibold">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time In</th>
                                    <th>Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in (List<itpayroll.Models.Attendance>)ViewBag.MyAttendance)
                                {
                                    var openShift = a.TimeOut == default || a.TimeOut <= a.TimeIn;
                                    <tr>
                                        <td>@a.Date.ToString("MMM dd")</td>
                                        <td>@a.TimeIn.ToString(@"hh\:mm")</td>
                                        <td>@(openShift ? "Open" : a.TotalHours.ToString("N2"))</td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Attendance>)ViewBag.MyAttendance).Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No attendance records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Last Request Status</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.LastOvertimeStatus != null)
                                {
                                    <tr>
                                        <td><i class="fas fa-business-time me-2"></i>Overtime</td>
                                        <td>
                                            @if (ViewBag.LastOvertimeStatus == "Pending") { <span class="badge bg-warning">Pending</span> }
                                            else if (ViewBag.LastOvertimeStatus == "Approved") { <span class="badge bg-success">Approved</span> }
                                            else { <span class="badge bg-danger">Rejected</span> }
                                        </td>
                                    </tr>
                                }
                                @if (ViewBag.LastLeaveStatus != null)
                                {
                                    <tr>
                                        <td><i class="fas fa-file-medical me-2"></i>Leave</td>
                                        <td>
                                            @if (ViewBag.LastLeaveStatus == "Pending") { <span class="badge bg-warning">Pending</span> }
                                            else if (ViewBag.LastLeaveStatus == "Approved") { <span class="badge bg-success">Approved</span> }
                                            else if (ViewBag.LastLeaveStatus == "Rejected") { <span class="badge bg-danger">Rejected</span> }
                                            else { <span class="badge bg-secondary">Cancelled</span> }
                                        </td>
                                    </tr>
                                }
                                @if (ViewBag.LastOvertimeStatus == null && ViewBag.LastLeaveStatus == null)
                                {
                                    <tr><td colspan="2" class="text-center text-muted">No requests yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Employee profile not found. Please contact your HR administrator.
        </div>
    }
}
