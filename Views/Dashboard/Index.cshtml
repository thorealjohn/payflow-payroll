@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Dashboard</h2>
    @await Html.PartialAsync("_PeriodSelector")
</div>

@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
{
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card kpi-card">
                <div class="kpi-label">Total Employees</div>
                <div class="kpi-value">@ViewBag.TotalEmployees</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card">
                <div class="kpi-label">Today's Attendance</div>
                <div class="kpi-value">@ViewBag.TodayAttendance</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card">
                <div class="kpi-label">Total Payrolls</div>
                <div class="kpi-value">@ViewBag.TotalPayrolls</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card kpi-card">
                <div class="kpi-label">Pending Release</div>
                <div class="kpi-value">@ViewBag.PendingPayrolls</div>
            </div>
        </div>

    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Total Net Pay Released</h5>
                </div>
                <div class="card-body">
                    <h2 class="text-success">₱@(((decimal)ViewBag.TotalPayrollAmount).ToString("N2"))</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Payrolls</h5>
                    <a asp-controller="Payroll" asp-action="Index" class="small text-success fw-semibold">View All</a>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Net Pay</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls)
                            {
                                var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : p.Status == itpayroll.Models.PayrollStatus.Processed ? "bg-primary" : "bg-secondary";
                                <tr>
                                    <td>@p.Employee.User?.FirstName @p.Employee.User?.LastName</td>
                                    <td>₱@p.NetPay.ToString("N2")</td>
                                    <td><span class="badge @badgeClass">@p.Status</span></td>
                                </tr>
                            }
                            @if (!((List<itpayroll.Models.Payroll>)ViewBag.RecentPayrolls).Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted">No payroll records yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Attendance</h5>
                    <a asp-controller="Attendance" asp-action="Index" class="small text-success fw-semibold">View All</a>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in (List<itpayroll.Models.Attendance>)ViewBag.RecentAttendances)
                            {
                                <tr>
                                    <td>@a.Employee.User?.FirstName @a.Employee.User?.LastName</td>
                                    <td>@a.Date.ToString("MMM dd")</td>
                                    <td>@a.TotalHours.ToString("N2") hrs</td>
                                </tr>
                            }
                            @if (!((List<itpayroll.Models.Attendance>)ViewBag.RecentAttendances).Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted">No attendance records yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Leave Statistics</h5>
                </div>
                <div class="card-body">
                    <canvas id="leaveChart" style="max-height: 200px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Monthly Payroll Trends</h5>
                </div>
                <div class="card-body">
                    <canvas id="payrollChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Daily Attendance Trends (Last 30 Days)</h5>
                </div>
                <div class="card-body">
                    <canvas id="attendanceChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // Leave Statistics Chart
            var leaveCtx = document.getElementById('leaveChart').getContext('2d');
            var leaveData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.LeaveStats));
            var leaveChart = new Chart(leaveCtx, {
                type: 'doughnut',
                data: {
                    labels: leaveData.map(x => x.Status),
                    datasets: [{
                        data: leaveData.map(x => x.Count),
                        backgroundColor: ['#ffc107', '#28a745', '#dc3545', '#6c757d']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Payroll Trends Chart
            var payrollCtx = document.getElementById('payrollChart').getContext('2d');
            var payrollData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MonthlyPayroll));
            var payrollChart = new Chart(payrollCtx, {
                type: 'line',
                data: {
                    labels: payrollData.map(x => x.Month),
                    datasets: [{
                        label: 'Total Net Pay',
                        data: payrollData.map(x => x.Total),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // Attendance Trends Chart
            var attendanceCtx = document.getElementById('attendanceChart').getContext('2d');
            var attendanceData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AttendanceTrend));
            var attendanceChart = new Chart(attendanceCtx, {
                type: 'bar',
                data: {
                    labels: attendanceData.map(x => new Date(x.Date).toLocaleDateString()),
                    datasets: [{
                        label: 'Attendance Count',
                        data: attendanceData.map(x => x.Count),
                        backgroundColor: '#198754'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        </script>
    }
}
else
{
    var employee = ViewBag.Employee as itpayroll.Models.Employee;
    if (employee != null)
    {
        // Summary Cards
        <div class="row g-3 mb-4">
            @* Today's Attendance Card *@
            <div class="col-md-3">
                @{
                    var todayStatus = ViewBag.TodayAttendanceStatus as string;
                    var todayCardColor = todayStatus == "Present" ? "bg-success" : todayStatus == "Late" ? "bg-warning" : "bg-danger";
                }
                <div class="card @todayCardColor text-white">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-calendar-day me-2"></i>Today's Attendance</h5>
                        <h2 class="display-6">@todayStatus</h2>
                    </div>
                </div>
            </div>

            @* This Month Hours Worked *@
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-clock me-2"></i>This Month Hours</h5>
                        <h2 class="display-6">@((decimal)ViewBag.MonthHoursWorked) hrs</h2>
                    </div>
                </div>
            </div>

            @* Pending Requests *@
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-tasks me-2"></i>Pending Requests</h5>
                        <h2 class="display-6">@ViewBag.PendingRequestsCount</h2>
                    </div>
                </div>
            </div>

            @* Latest Net Pay *@
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-money-bill me-2"></i>Latest Net Pay</h5>
                        <h2 class="display-6">₱@((decimal?)ViewBag.LatestNetPay ?? 0).ToString("N2")</h2>
                    </div>
                </div>
            </div>
        </div>

        @* Quick Actions *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body d-flex gap-2">
                        <form asp-controller="Attendance" asp-action="TimeIn" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-success" onclick="return confirm('Record Time In now?')">
                                <i class="fas fa-sign-in-alt me-2"></i>Time In
                            </button>
                        </form>
                        <form asp-controller="Attendance" asp-action="TimeOut" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Record Time Out now?')">
                                <i class="fas fa-sign-out-alt me-2"></i>Time Out
                            </button>
                        </form>
                        <a asp-controller="Overtime" asp-action="MyOvertime" class="btn btn-outline-success">
                            <i class="fas fa-business-time me-2"></i>Request Overtime
                        </a>
                        <a asp-controller="Leave" asp-action="Create" class="btn btn-outline-info">
                            <i class="fas fa-file-medical me-2"></i>File Leave
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Recent Activity *@
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Payslips</h5>
                        <a asp-controller="Payroll" asp-action="MyPayslips" class="small text-success fw-semibold">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Net Pay</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in (List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls)
                                {
                                    var badgeClass = p.Status == itpayroll.Models.PayrollStatus.Released ? "bg-success" : "bg-primary";
                                    <tr>
                                        <td>@p.PeriodStart.ToString("MMM dd") - @p.PeriodEnd.ToString("MMM dd")</td>
                                        <td>₱@p.NetPay.ToString("N2")</td>
                                        <td><span class="badge @badgeClass">@p.Status</span></td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Payroll>)ViewBag.MyPayrolls).Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No payslip records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Attendance</h5>
                        <a asp-controller="Attendance" asp-action="MyAttendance" class="small text-success fw-semibold">View All</a>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time In</th>
                                    <th>Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in (List<itpayroll.Models.Attendance>)ViewBag.MyAttendance)
                                {
                                    <tr>
                                        <td>@a.Date.ToString("MMM dd")</td>
                                        <td>@a.TimeIn.ToString(@"hh\:mm")</td>
                                        <td>@a.TotalHours.ToString("N2")</td>
                                    </tr>
                                }
                                @if (!((List<itpayroll.Models.Attendance>)ViewBag.MyAttendance).Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No attendance records yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Last Request Status</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.LastOvertimeStatus != null)
                                {
                                    <tr>
                                        <td><i class="fas fa-business-time me-2"></i>Overtime</td>
                                        <td>
                                            @if (ViewBag.LastOvertimeStatus == "Pending") { <span class="badge bg-warning">Pending</span> }
                                            else if (ViewBag.LastOvertimeStatus == "Approved") { <span class="badge bg-success">Approved</span> }
                                            else { <span class="badge bg-danger">Rejected</span> }
                                        </td>
                                    </tr>
                                }
                                @if (ViewBag.LastLeaveStatus != null)
                                {
                                    <tr>
                                        <td><i class="fas fa-file-medical me-2"></i>Leave</td>
                                        <td>
                                            @if (ViewBag.LastLeaveStatus == "Pending") { <span class="badge bg-warning">Pending</span> }
                                            else if (ViewBag.LastLeaveStatus == "Approved") { <span class="badge bg-success">Approved</span> }
                                            else if (ViewBag.LastLeaveStatus == "Rejected") { <span class="badge bg-danger">Rejected</span> }
                                            else { <span class="badge bg-secondary">Cancelled</span> }
                                        </td>
                                    </tr>
                                }
                                @if (ViewBag.LastOvertimeStatus == null && ViewBag.LastLeaveStatus == null)
                                {
                                    <tr><td colspan="2" class="text-center text-muted">No requests yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Employee profile not found. Please contact your HR administrator.
        </div>
    }
}
