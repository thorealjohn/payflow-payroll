@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@model List<itpayroll.Areas.Identity.Data.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var currentUserRole = ViewBag.CurrentUserRole as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">User Management</h4>
        <small class="text-muted">Manage system users and roles</small>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">+ New User</a>
        }
        <a asp-action="AuditLogs" class="btn btn-outline-info">Audit Logs</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">

        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    if (user.IsDeleted) continue;

                    var statusBadge = user.IsActive ? "bg-success" : "bg-danger";
                    var statusText = user.IsActive ? "Active" : "Inactive";
                    var targetRole = ViewBag.UserRoles[user.Id] as string;
                    var canModify = CanUserModify(currentUserRole!, targetRole);

                    <tr class="@(user.IsActive ? "" : "table-secondary")">

                        <td class="px-4 fw-medium">
                            @user.FirstName @user.LastName
                        </td>

                        <td>@user.Email</td>

                        <td>
                            <span class="badge bg-secondary">
                                @targetRole
                            </span>
                        </td>

                        <td>
                            <span class="badge @statusBadge">
                                @statusText
                            </span>
                        </td>

                        <td class="text-end px-4">

                            @if (canModify)
                            {
                                <a asp-action="Edit" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-warning">Edit</a>

                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info">View</a>

                                <form asp-action="ToggleStatus" asp-route-id="@user.Id"
                                      method="post" class="d-inline">

                                    <button type="submit"
                                            class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">

                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>

                                @if (targetRole != "SuperAdmin" && !(targetRole == "Admin" && currentUserRole == "Admin"))
                                {
                                    <form asp-action="SoftDelete" asp-route-id="@user.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to deactivate this user?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info">View</a>

                                <span class="text-muted ms-2 small">
                                    No access
                                </span>
                            }

                        </td>
                    </tr>
                }

                @if (!Model.Any(u => !u.IsDeleted))
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No users found
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
</div>

@functions {
    bool CanUserModify(string currentUserRole, string? targetRole)
    {
        if (string.IsNullOrEmpty(targetRole)) return false;

        return (currentUserRole, targetRole) switch
        {
            ("SuperAdmin", _) => true,
            ("Admin", "HR") => true,
            ("Admin", "Employee") => true,
            ("HR", "Employee") => true,
            _ => false
        };
    }
}
