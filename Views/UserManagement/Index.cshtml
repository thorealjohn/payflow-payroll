@model List<itpayroll.Areas.Identity.Data.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var currentUserRole = ViewBag.CurrentUserRole as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>User Management</h2>
    <a asp-action="Create" class="btn btn-success">Create New User</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            if (user.IsDeleted) continue;

            var statusBadge = user.IsActive ? "bg-success" : "bg-danger";
            var statusText = user.IsActive ? "Active" : "Inactive";
            var targetRole = ViewBag.UserRoles[user.Id] as string;
            var canModify = CanUserModify(currentUserRole!, targetRole);

            <tr class="@(user.IsActive ? "" : "table-secondary")">
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td><span class="badge bg-secondary">@targetRole</span></td>
                <td><span class="badge @statusBadge">@statusText</span></td>
                <td>
                    @if (canModify)
                    {
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info">View</a>
                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                @(user.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        @if (targetRole != "SuperAdmin" && !(targetRole == "Admin" && currentUserRole == "Admin"))
                        {
                            <form asp-action="SoftDelete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this user?');">
                                <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                            </form>
                        }
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info">View</a>
                        <span class="text-muted ms-2"><small>No modify access</small></span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    bool CanUserModify(string currentUserRole, string? targetRole)
    {
        if (string.IsNullOrEmpty(targetRole)) return false;

        return (currentUserRole, targetRole) switch
        {
            ("SuperAdmin", _) => true,
            ("Admin", "HR") => true,
            ("Admin", "Employee") => true,
            ("HR", "Employee") => true,
            _ => false
        };
    }
}
