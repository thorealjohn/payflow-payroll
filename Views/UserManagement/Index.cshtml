@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@model List<itpayroll.Areas.Identity.Data.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var currentUserRole = ViewBag.CurrentUserRole as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">User Management</h4>
        <small class="text-muted">Manage system users and roles</small>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">New User</a>
        }
    </div>
</div>

<form method="get" class="d-flex gap-2 mb-3 align-items-center">

    <input type="text"
           name="searchString"
           class="form-control"
           placeholder="Search by name or email..."
           value="@Context.Request.Query["searchString"]" />

    <select name="role" class="form-select w-auto">
        <option value="">All Roles</option>
        <option value="SuperAdmin">SuperAdmin</option>
        <option value="Admin">Admin</option>
        <option value="HR">HR</option>
        <option value="Employee">Employee</option>
    </select>

    <select name="status" class="form-select w-auto">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
    </select>

    @await Html.PartialAsync("_PeriodSelector")

</form>

<div class="card">
    <div class="card-body p-0">

        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end px-4">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    if (user.IsDeleted) continue;

                    var statusBadge = user.IsActive ? "bg-success" : "bg-danger";
                    var statusText = user.IsActive ? "Active" : "Inactive";
                    var targetRole = ViewBag.UserRoles[user.Id] as string;
                    var canModify = CanUserModify(currentUserRole!, targetRole);

                    <tr class="@(user.IsActive ? "" : "table-secondary")">

                        <td class="px-4 fw-medium">
                            @user.FirstName @user.LastName
                        </td>

                        <td>@user.Email</td>

                        <td>
                            <span class="badge bg-secondary">
                                @targetRole
                            </span>
                        </td>

                        <td>
                            <span class="badge @statusBadge">
                                @statusText
                            </span>
                        </td>

                        <td class="text-end px-4">

                            @if (canModify)
                            {
                                <a asp-action="Edit" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-warning">Edit</a>

                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info">View</a>

                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        More
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <li>
                                            <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="dropdown-item">
                                                    @(user.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </li>

                                        @if (targetRole != "SuperAdmin" && !(targetRole == "Admin" && currentUserRole == "Admin"))
                                        {
                                            <li>
                                                <form asp-action="SoftDelete" asp-route-id="@user.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to delete this user?');">

                                                    <button type="submit" class="dropdown-item text-danger">
                                                        Delete
                                                    </button>
                                                </form>
                                            </li>
                                        }

                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info">View</a>

                                <span class="text-muted ms-2 small">
                                    No access
                                </span>
                            }

                        </td>
                    </tr>
                }

                @if (!Model.Any(u => !u.IsDeleted))
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No users found
                        </td>
                    </tr>
                }

            </tbody>
        </table>

@{
    int current = ViewBag.CurrentPage ?? 1;
    int total = ViewBag.TotalPages ?? 1;

    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, current + 2);
}

        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">

            <small class="text-muted">
                Page @current of @total
            </small>

            <div class="d-flex gap-1 flex-wrap">

                <!-- Previous -->
                <a href="?page=@(current - 1)"
                   class="btn btn-sm btn-outline-primary @(current == 1 ? "disabled" : "")">
                    Previous
                </a>

                <!-- First -->
                @if (start > 1)
                {
                    <a href="?page=1" class="btn btn-sm btn-outline-primary">1</a>

                    @if (start > 2)
                    {
                        <span class="px-2">...</span>
                    }
                }

                <!-- Middle -->
                @for (int i = start; i <= end; i++)
                {
                    <a href="?page=@i"
                       class="btn btn-sm @(i == current ? "btn-primary" : "btn-outline-primary")">
                        @i
                    </a>
                }

                <!-- Last -->
                @if (end < total)
                {
                    @if (end < total - 1)
                    {
                        <span class="px-2">...</span>
                    }

                    <a href="?page=@total"
                       class="btn btn-sm btn-outline-primary">@total</a>
                }

                <!-- Next -->
                <a href="?page=@(current + 1)"
                   class="btn btn-sm btn-outline-primary @(current == total ? "disabled" : "")">
                    Next
                </a>

            </div>
        </div>

@functions {
    bool CanUserModify(string currentUserRole, string? targetRole)
    {
        if (string.IsNullOrEmpty(targetRole)) return false;

        return (currentUserRole, targetRole) switch
        {
            ("SuperAdmin", _) => true,
            ("Admin", "HR") => true,
            ("Admin", "Employee") => true,
            ("HR", "Employee") => true,
            _ => false
        };
    }
}
