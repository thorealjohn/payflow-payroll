@model itpayroll.Areas.Identity.Data.ApplicationUser
@{
    ViewData["Title"] = "User Details";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">User Details</h4>
    <small class="text-muted">View user information and role</small>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Role(s)</dt>
            <dd class="col-sm-9">
                @foreach (var role in ViewBag.Roles)
                {
                    <span class="badge bg-secondary me-1">@role</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </dd>

            <dt class="col-sm-3">Last Login</dt>
            <dd class="col-sm-9">@(Model.LastLoginDate?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CreatedBy on @Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

            @if (Model.ModifiedDate.HasValue)
            {
                <dt class="col-sm-3">Modified By</dt>
                <dd class="col-sm-9">@Model.ModifiedBy on @Model.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>
            }
        </dl>
    </div>
</div>

@if (ViewBag.Employee != null)
{
    var employee = (itpayroll.Models.Employee)ViewBag.Employee!;
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">Employee Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Employee Number</dt>
                <dd class="col-sm-9">@employee.EmployeeNumber</dd>

                <dt class="col-sm-3">Basic Salary</dt>
                <dd class="col-sm-9">₱@employee.BasicSalary.ToString("N2")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(employee.Status == itpayroll.Models.EmploymentStatus.Active ? "bg-success" : "bg-danger")">
                        @employee.Status
                    </span>
                </dd>

                <dt class="col-sm-3">Hire Date</dt>
                <dd class="col-sm-9">@employee.HireDate.ToString("MMM dd, yyyy")</dd>
            </dl>
        </div>
    </div>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-warning">Reset Password</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
