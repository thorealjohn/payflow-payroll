@model itpayroll.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">Reset Password</h4>
    <small class="text-muted">Set a new password for <strong>@Model.UserDisplayName</strong></small>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="UserId" />
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">User</label>
                <input type="text" class="form-control" value="@Model.UserDisplayName" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="text" class="form-control" value="@Model.Email" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <small class="text-muted">Must be at least 10 characters with uppercase, lowercase, digit, and special character.</small>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                The user will be required to change their password on next login.
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Reset Password</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
