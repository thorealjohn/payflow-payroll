<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PayFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/itpayroll.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm pf-navbar">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="@BrandingOptions.Value.LogoPath" alt="PayFlow" width="40" height="40" class="app-brand-logo me-2 rounded-2 flex-shrink-0" asp-append-version="true" />
                    <span class="fw-bold text-success">PayFlow</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Employees</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="Index">All Employees</a></li>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Employee" asp-action="Create">Add Employee</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Attendance</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">All Records</a></li>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Create">Log Attendance</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Payroll</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Index">Payroll Records</a></li>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Process">Process Payroll</a></li>
                                        }
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" asp-controller="PayrollSettings" asp-action="Index">Payroll Settings</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Employee") || User.IsInRole("Admin") || User.IsInRole("HR"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Attendance" asp-action="MyAttendance">My Attendance</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Overtime" asp-action="MyOvertime">My Overtime</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Leave" asp-action="MyLeaves">My Leave</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Payroll" asp-action="MyPayslips">My Payslips</a>
                                </li>
                            }
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">System</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">Manage Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="AuditLogs">Audit Logs</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PayFlow - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/tom-select/tom-select.complete.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.tom-select').forEach(el => new TomSelect(el));
        });
    </script>
</body>
</html>
