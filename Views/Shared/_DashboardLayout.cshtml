@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - PayFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            overflow-x: hidden;
            background: #f5f6fa;
        }

		.logo-full {
            letter-spacing: 1px;
			font-size: 2px;
        }

        .logo-mini {
			font-size: 18px;
            display: none;
            font-weight: bold;
        }

        .sidebar.collapsed .logo-full {
            display: none;
        }

        .sidebar.collapsed .logo-mini {
            display: block;
        }

        .nav-link.active {
            background: rgba(255,255,255,0.25);
            font-weight: 600;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            background: linear-gradient(180deg, #198754, #157347);
            color: white;
            padding-top: 20px;
            transition: all 0.3s;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                color: rgba(255,255,255,0.85);
                padding: 12px 20px;
                border-radius: 8px;
                margin: 5px 10px;
                transition: all 0.2s;

            }

            .sidebar i {
                width: 20px;
                text-align: center;
            }

                .sidebar a:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                    transform: translateX(5px);
                }

            .sidebar .text {
                margin-left: 10px;
            }

            .sidebar.collapsed .text {
                display: none;
            }

        .content {
            margin-left: 250px;
            padding: 25px;
            transition: all 0.3s;
        }

            .content.expanded {
                margin-left: 70px;
            }

        .topbar {
            background: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .toggle-btn {
            cursor: pointer;
            font-size: 20px;
            margin-right: 15px;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="text-center mb-4">
            <span class="logo-full fw-bold fs-4">PayFlow</span>
            <span class="logo-mini fw-bold">PF</span>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
            <i class="fas fa-chart-line"></i>
            <span class="text">Dashboard</span>
        </a>

        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-controller="UserManagement" asp-action="Index" class="nav-link @(currentController == "UserManagement" ? "active" : "")">
                <i class="fas fa-users"></i>
                <span class="text">Users</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <a asp-controller="Employee" asp-action="Index" class="nav-link @(currentController == "Employee" ? "active" : "")">
                <i class="fas fa-id-badge"></i>
                <span class="text">Employees</span>
            </a>
        }

        <a asp-controller="Attendance" asp-action="Index" class="nav-link @(currentController == "Attendance" ? "active" : "")">
            <i class="fas fa-clock"></i>
            <span class="text">Attendance</span>
        </a>

        <a asp-controller="Payroll" asp-action="Index" class="nav-link @(currentController == "Payroll" ? "active" : "")">
            <i class="fas fa-money-bill-wave"></i>
            <span class="text">Payroll</span>
        </a>
    </div>

    <!-- Main Content -->
    <div class="content">
        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <div>
                <span class="toggle-btn" onclick="toggleSidebar()">☰</span>
            </div>

            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle px-3 py-2" data-bs-toggle="dropdown">
                    <strong>@(User.Identity?.Name?.Split('@')[0]?.ToUpper())
                    </strong>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li class="dropdown-item text-muted small">
                        @User.Identity?.Name
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                            <button type="submit" class="dropdown-item text-danger">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Page Content -->
        <div class="mt-4">
            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('collapsed');
            document.querySelector('.content').classList.toggle('expanded');
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>