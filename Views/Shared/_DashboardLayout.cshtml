@using itpayroll.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var displayName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : User.Identity?.Name ?? "User";
    var primaryRole = userRoles.FirstOrDefault() ?? "User";
    var initials = currentUser != null
        ? $"{currentUser.FirstName?.FirstOrDefault()}{currentUser.LastName?.FirstOrDefault()}".Trim().ToUpper()
        : (User.Identity?.Name?[0].ToString().ToUpper() ?? "U");
    var profilePicPath = currentUser?.ProfilePicturePath;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PayFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <!-- Sidebar -->
    <div id="sidebar" class="sidebar">
        <div class="text-center mb-4 sidebar-brand">
            <img src="@BrandingOptions.Value.LogoPath" alt="PayFlow" width="44" height="44" class="app-brand-logo sidebar-logo mx-auto rounded-3 mb-2" asp-append-version="true" />
            <span class="logo-full fw-bold fs-4 text-white">PayFlow</span>
            <span class="logo-mini fw-bold text-white">PF</span>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
            <i class="fas fa-chart-line"></i>
            <span class="text">Dashboard</span>
        </a>

        @if (User.IsInRole("SuperAdmin"))
        {
            bool isUsersSection = currentController == "UserManagement";
            <div class="sidebar-accordion">
                <a class="nav-link @(isUsersSection ? "active" : "")" data-bs-toggle="collapse" href="#usersCollapse" role="button" aria-expanded="@(isUsersSection ? "true" : "false")">
                    <i class="fas fa-users-cog"></i>
                    <span class="text">System</span>
                    <i class="fas fa-chevron-right sidebar-chevron ms-auto @(isUsersSection ? "rotated" : "")"></i>
                </a>
                <div class="collapse sidebar-submenu @(isUsersSection ? "show" : "")" id="usersCollapse">
                    <a asp-controller="UserManagement" asp-action="Index" class="nav-link @(currentController == "UserManagement" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="text">Manage Users</span>
                    </a>
                    <a asp-controller="UserManagement" asp-action="AuditLogs" class="nav-link @(currentController == "UserManagement" && ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                        <span class="text">Audit Logs</span>
                    </a>
                </div>
            </div>
        }

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-controller="Employee" asp-action="Index" class="nav-link @(currentController == "Employee" ? "active" : "")">
                <i class="fas fa-user-tie"></i>
                <span class="text">Employees</span>
            </a>
        }

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-controller="Shift" asp-action="Index" class="nav-link @(currentController == "Shift" ? "active" : "")">
                <i class="fas fa-clock"></i>
                <span class="text">Shifts</span>
            </a>
        }

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            bool isAttendanceSection = currentController == "Attendance" || currentController == "Leave";
            <div class="sidebar-accordion">
                <a class="nav-link @(isAttendanceSection ? "active" : "")" data-bs-toggle="collapse" href="#attendanceCollapse" role="button" aria-expanded="@(isAttendanceSection ? "true" : "false")">
                    <i class="fas fa-clipboard-check"></i>
                    <span class="text">Attendance</span>
                    <i class="fas fa-chevron-right sidebar-chevron ms-auto @(isAttendanceSection ? "rotated" : "")"></i>
                </a>
                <div class="collapse sidebar-submenu @(isAttendanceSection ? "show" : "")" id="attendanceCollapse">
                    <a asp-controller="Attendance" asp-action="Index" class="nav-link @(currentController == "Attendance" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="text">All Attendance</span>
                    </a>
                    <a asp-controller="Leave" asp-action="Index" class="nav-link @(currentController == "Leave" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="text">Leave Requests</span>
                    </a>
                </div>
            </div>

            <a asp-controller="Overtime" asp-action="Index" class="nav-link @(currentController == "Overtime" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-business-time"></i>
                <span class="text">Overtime</span>
            </a>

            <a asp-controller="Payroll" asp-action="Index" class="nav-link @(currentController == "Payroll" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-money-bill-wave"></i>
                <span class="text">Payroll</span>
            </a>

            bool isReportsSection = currentController == "Reports";
            <div class="sidebar-accordion">
                <a class="nav-link @(isReportsSection ? "active" : "")" data-bs-toggle="collapse" href="#reportsCollapse" role="button" aria-expanded="@(isReportsSection ? "true" : "false")">
                    <i class="fas fa-chart-bar"></i>
                    <span class="text">Reports</span>
                    <i class="fas fa-chevron-right sidebar-chevron ms-auto @(isReportsSection ? "rotated" : "")"></i>
                </a>
                <div class="collapse sidebar-submenu @(isReportsSection ? "show" : "")" id="reportsCollapse">
                    <a asp-controller="Reports" asp-action="PayrollReport" class="nav-link @(currentController == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "PayrollReport" ? "active" : "")">
                        <span class="text">Payroll Report</span>
                    </a>
                    <a asp-controller="Reports" asp-action="AttendanceReport" class="nav-link @(currentController == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "AttendanceReport" ? "active" : "")">
                        <span class="text">Attendance Report</span>
                    </a>
                    <a asp-controller="Reports" asp-action="EmployeeReport" class="nav-link @(currentController == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "EmployeeReport" ? "active" : "")">
                        <span class="text">Employee Report</span>
                    </a>
                </div>
            </div>
        }

        @if (User.IsInRole("Employee"))
        {
            <a asp-controller="Attendance" asp-action="MyAttendance" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyAttendance" ? "active" : "")">
                <i class="fas fa-calendar-check"></i>
                <span class="text">My Attendance</span>
            </a>

            <a asp-controller="Overtime" asp-action="MyOvertime" class="nav-link @(currentController == "Overtime" && ViewContext.RouteData.Values["action"]?.ToString() == "MyOvertime" ? "active" : "")">
                <i class="fas fa-business-time"></i>
                <span class="text">My Overtime</span>
            </a>

            <a asp-controller="Leave" asp-action="MyLeaves" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyLeaves" ? "active" : "")">
                <i class="fas fa-file-medical"></i>
                <span class="text">My Leave</span>
            </a>

            <a asp-controller="Payroll" asp-action="MyPayslips" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyPayslips" ? "active" : "")">
                <i class="fas fa-file-invoice-dollar"></i>
                <span class="text">My Payslips</span>
            </a>

            <a asp-controller="Account" asp-action="Profile" class="nav-link @(currentController == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
                <i class="fas fa-user-circle"></i>
                <span class="text">Profile</span>
            </a>
        }
    </div>

    <!-- Main Content -->
    <div class="content">
        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">

            <!-- LEFT -->
            <div class="d-flex align-items-center gap-3">
                <span id="sidebarToggle" class="toggle-btn">☰</span>
                <strong class="fs-5">@ViewData["Title"]</strong>
            </div>

            <!-- RIGHT -->
            <div class="d-flex align-items-center gap-3">

     

                <!-- Notification -->
                <div class="position-relative dropdown">
                    <button class="btn btn-link text-decoration-none position-relative" data-bs-toggle="dropdown">
                        <i class="fas fa-bell fs-5 text-muted"></i>
                        <span id="notificationCount" class="position-absolute top--1 start--1 badge bg-danger rounded-pill d-none" style="font-size: 0.6rem;">0</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" style="width: 350px; max-height: 400px; overflow-y: auto;">
                        <li class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <strong>Notifications</strong>
                            <button id="markAllRead" class="btn btn-sm btn-link text-decoration-none">Mark all read</button>
                        </li>
                        <div id="notificationList">
                            <li class="px-3 py-4 text-center text-muted">
                                <small>Loading...</small>
                            </li>
                        </div>
                    </ul>
                </div>

                <!-- User -->
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 px-3 py-2"
                             type="button"
                             data-bs-toggle="dropdown"
                             aria-expanded="false">
                        @if (!string.IsNullOrWhiteSpace(profilePicPath))
                        {
                            <img src="@profilePicPath" alt="Profile" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="avatar">
                                @initials
                            </div>
                        }
                        <div class="text-start lh-sm">
                            <strong class="d-block" style="font-size: 0.85rem;">@displayName</strong>
                            <small class="text-muted" style="font-size: 0.7rem;">@primaryRole</small>
                        </div>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 220px;">
                        <li class="px-3 py-2 text-center border-bottom">
                            <div class="fw-semibold">@displayName</div>
                            <span class="badge bg-secondary mt-1">@primaryRole</span>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                <i class="fas fa-user-circle me-2"></i>My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">
                                <i class="fas fa-shield-alt me-2"></i>Security
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                <i class="fas fa-key me-2"></i>Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li class="px-3 py-2 d-flex justify-content-between align-items-center">
                            <span>Dark Mode</span>

                            <label class="switch mb-0">
                                <input type="checkbox" id="themeToggle" onclick="toggleDarkMode()">
                                <span class="slider"></span>
                            </label>
                        </li>
                        <li>
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button type="submit" class="dropdown-item text-danger">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>

        </div>

        <!-- Page Content -->
        <div class="mt-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    

    @await RenderSectionAsync("Scripts", required: false)
    @Html.AntiForgeryToken()
    <div class="modal fade" id="securityPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="securityPasswordInput" class="form-label">Enter your password to continue.</label>
                    <div class="position-relative">
                        <input type="password" id="securityPasswordInput" class="form-control pe-5" autocomplete="current-password" />
                        <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleSecurityPassword" style="z-index: 5; text-decoration: none; background: none;">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="text-danger small mt-2 d-none" id="securityPasswordError">Password is required.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="securityPasswordConfirm">Continue</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Wait for full page load
        document.addEventListener("DOMContentLoaded", function() {
            initTheme();
            initSidebar();
            initSecurityPasswordModal();

            // Prevent dropdown from closing when interacting with dark mode toggle
            const themeToggle = document.getElementById('themeToggle');
            if (themeToggle) {
                themeToggle.addEventListener('click', (e) => e.stopPropagation());
            }
        });

        function toggleDarkMode() {
            const root = document.documentElement;
            const isDark = root.classList.toggle('dark-mode');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');

            const toggle = document.getElementById('themeToggle');
            if (toggle) toggle.checked = isDark;
        }

        function initTheme() {
            const isDark = document.documentElement.classList.contains('dark-mode');
            const toggle = document.getElementById('themeToggle');
            if (toggle) toggle.checked = isDark;
        }

                function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const content = document.querySelector('.content');

            if (!sidebar || !content) {
                console.error("Sidebar or content not found");
                return;
            }

            sidebar.classList.toggle('collapsed');
            content.classList.toggle('expanded');

            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        function initSidebar() {
            // Check if sidebar should be collapsed from localStorage
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            const sidebar = document.querySelector('.sidebar');
            const content = document.querySelector('.content');

            if (isCollapsed && sidebar && content) {
                sidebar.classList.add('collapsed');
                content.classList.add('expanded');
            }

            // Initialize accordion behavior
            initAccordion();
        }

        function initAccordion() {
            // Handle sidebar accordion toggles
            const accordionToggles = document.querySelectorAll('.sidebar-accordion > a[data-bs-toggle="collapse"]');

            accordionToggles.forEach(toggle => {
                toggle.addEventListener('click', function(e) {
                    // Remove rotated class from all chevrons
                    document.querySelectorAll('.sidebar-chevron').forEach(chevron => {
                        chevron.classList.remove('rotated');
                    });

                    // Add rotated class to clicked toggle's chevron
                    const chevron = this.querySelector('.sidebar-chevron');
                    if (chevron) {
                        chevron.classList.toggle('rotated');
                    }

                    // Save accordion state to localStorage
                    const targetId = this.getAttribute('href').substring(1);
                    const isOpen = document.getElementById(targetId).classList.contains('show');
                    localStorage.setItem('accordion_' + targetId, isOpen);
                });
            });

            // Restore accordion state from localStorage
            accordionToggles.forEach(toggle => {
                const targetId = toggle.getAttribute('href').substring(1);
                const isOpen = localStorage.getItem('accordion_' + targetId) === 'true';
                const target = document.getElementById(targetId);
                const chevron = toggle.querySelector('.sidebar-chevron');

                if (isOpen && target && !target.classList.contains('show')) {
                    // Re-open the accordion
                    new bootstrap.Collapse(target, { toggle: false }).show();
                    if (chevron) chevron.classList.add('rotated');
                }
            });
        }

      
        // Make toggleSidebar globally available
        window.toggleSidebar = toggleSidebar;
        window.toggleDarkMode = toggleDarkMode;

        function initSecurityPasswordModal() {
            const sensitiveActions = ['Edit', 'Delete', 'SoftDelete', 'Release', 'Void', 'Approve', 'Reject', 'Process'];
            const modalElement = document.getElementById('securityPasswordModal');
            const input = document.getElementById('securityPasswordInput');
            const error = document.getElementById('securityPasswordError');
            const confirmButton = document.getElementById('securityPasswordConfirm');
            if (!modalElement || !input || !confirmButton) return;

            const modal = new bootstrap.Modal(modalElement);
            let pendingForm = null;

            document.querySelectorAll('form[method="post"], form[method="POST"]').forEach(form => {
                const action = form.getAttribute('action') || '';
                const isSensitive = sensitiveActions.some(word => action.toLowerCase().includes(word.toLowerCase()));
                if (!isSensitive) return;

                form.addEventListener('submit', function (event) {
                    if (form.dataset.securityConfirmed === 'true') return;
                    event.preventDefault();
                    pendingForm = form;
                    input.value = '';
                    error.classList.add('d-none');
                    modal.show();
                    setTimeout(() => input.focus(), 150);
                });
            });

            confirmButton.addEventListener('click', function () {
                if (!pendingForm) return;
                const password = input.value.trim();
                if (!password) {
                    error.classList.remove('d-none');
                    input.focus();
                    return;
                }

                let hidden = pendingForm.querySelector('input[name="SecurityPassword"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'SecurityPassword';
                    pendingForm.appendChild(hidden);
                }

                hidden.value = password;
                pendingForm.dataset.securityConfirmed = 'true';
                modal.hide();
                pendingForm.submit();
            });
        }

        // Notification functions
        function loadNotifications() {
            fetch('@Url.Action("GetRecent", "Notifications")')
                .then(r => r.json())
                .then(data => {
                    const list = document.getElementById('notificationList');
                    const countBadge = document.getElementById('notificationCount');

                    if (data.length === 0) {
                        list.innerHTML = '<li class="px-3 py-4 text-center text-muted"><small>No notifications</small></li>';
                        countBadge.classList.add('d-none');
                        return;
                    }

                    let html = '';
                    let unreadCount = 0;

                    data.forEach(n => {
                        if (!n.isRead) unreadCount++;
                        html += `
                            <li class="dropdown-item ${n.isRead ? '' : 'bg-light'}">
                                <div class="d-flex justify-content-between">
                                    <strong class="small">${n.title}</strong>
                                    <small class="text-muted">${n.createdDate}</small>
                                </div>
                                <p class="small mb-1 text-muted">${n.message}</p>
                                ${!n.isRead ? `<button class="btn btn-sm btn-link p-0" onclick="markRead(${n.notificationId})">Mark read</button>` : ''}
                            </li>
                        `;
                    });

                    list.innerHTML = html;

                    if (unreadCount > 0) {
                        countBadge.textContent = unreadCount;
                        countBadge.classList.remove('d-none');
                    } else {
                        countBadge.classList.add('d-none');
                    }
                });
        }

        function markRead(id) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("MarkAsRead", "Notifications")';

            const token = document.createElement('input');
            token.type = 'hidden';
            token.name = '__RequestVerificationToken';
            token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;

            form.appendChild(token);

            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            form.appendChild(idInput);

            document.body.appendChild(form);
            form.submit();
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadNotifications();
            setInterval(loadNotifications, 60000); // Refresh every minute

            const markAllBtn = document.getElementById('markAllRead');
            if (markAllBtn) {
                markAllBtn.addEventListener('click', function() {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("MarkAllAsRead", "Notifications")';

                    const token = document.createElement('input');
                    token.type = 'hidden';
                    token.name = '__RequestVerificationToken';
                    token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    form.appendChild(token);
                    document.body.appendChild(form);
                    form.submit();
                });
            }
                    // 🔥 SIDEBAR TOGGLE FIX
        const toggleBtn = document.getElementById('sidebarToggle');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const sidebar = document.getElementById('sidebar');
                const content = document.querySelector('.content');

                if (!sidebar || !content) {
                    console.error("Sidebar or content not found");
                    return;
                }

                sidebar.classList.toggle('collapsed');
                content.classList.toggle('expanded');
            });
        }
        });
        // Toggle security password visibility
        document.getElementById('toggleSecurityPassword')?.addEventListener('click', function () {
            var input = document.getElementById('securityPasswordInput');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
    </script>
</body>
</html>
