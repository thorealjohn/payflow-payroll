@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <!-- Title -->
                <h3 class="text-center fw-bold mb-3">Forgot Password</h3>
                <p class="text-center text-muted mb-4">
                    Enter your email and we’ll send you a reset link
                </p>

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Email -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Button -->
                    <button type="submit" class="w-100 btn btn-success btn-lg fw-semibold">
                        Reset Password
                    </button>

                    <!-- Back link -->
                    <div class="text-center mt-3">
                        <a asp-page="./Login" class="small text-success">
                            Back to Login
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
