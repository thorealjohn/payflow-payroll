@page
@model SetPasswordModel
@{
    Layout = "/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Set your password</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</p>
<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.NewPassword" class="form-control pe-5" autocomplete="new-password" placeholder="Please enter your new password." id="setNewPassword" />
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleSetNewPassword" style="z-index: 5; text-decoration: none; background: none;">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.ConfirmPassword" class="form-control pe-5" autocomplete="new-password" placeholder="Please confirm your new password." id="setConfirmPassword" />
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                <button type="button" class="btn btn-link position-absolute end-0 top-0 h-100 d-flex align-items-center text-muted" id="toggleSetConfirmPassword" style="z-index: 5; text-decoration: none; background: none;">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Set password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleSetNewPassword').addEventListener('click', function () {
            var input = document.getElementById('setNewPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
        document.getElementById('toggleSetConfirmPassword').addEventListener('click', function () {
            var input = document.getElementById('setConfirmPassword');
            var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.querySelector('i').className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        });
    </script>
}
