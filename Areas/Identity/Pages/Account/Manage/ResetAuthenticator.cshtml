@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset Authenticator Key";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="container-fluid">
    <div class="row g-4">
        <div class="col-xl-8">
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Reset Authenticator Key</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <p class="fw-semibold mb-2">This will disable 2FA and reset your authenticator app key.</p>
                        <p class="mb-0">
                            You will need to reconfigure your authenticator app. This does not change recovery codes.
                        </p>
                    </div>

                    <form method="post">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-redo me-2"></i>Reset Authenticator Key
                        </button>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
