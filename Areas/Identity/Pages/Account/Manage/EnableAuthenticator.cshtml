@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set Up Authenticator App";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="container-fluid">
    <div class="row g-4">
        <div class="col-xl-8">
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Configure Authenticator App</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">To use an authenticator app, follow these steps:</p>

                    <ol class="list-group list-group-numbered mb-4">
                        <li class="list-group-item border-0 ps-0">
                            <strong>Download an authenticator app</strong> like
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank">Microsoft Authenticator (Android)</a>,
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank">Microsoft Authenticator (iOS)</a>, or
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" target="_blank">Google Authenticator</a>.
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <strong>Scan the QR code</strong> below or enter the key manually.
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <strong>Enter the verification code</strong> from the app to confirm setup.
                        </li>
                    </ol>

                    <div class="row g-4">
                        <div class="col-md-6 text-center">
                            <div class="card bg-light border-0">
                                <div class="card-body py-4">
                                    <h6 class="text-muted mb-3">Scan QR Code</h6>
                                    <div id="qrCode" class="mb-3"></div>
                                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0">
                                <div class="card-body py-4">
                                    <h6 class="text-muted mb-3">Or Enter This Key</h6>
                                    <kbd class="d-block p-3 mb-3 text-center" style="font-size: 1.1rem; letter-spacing: 2px; word-break: break-all;">
                                        @Model.SharedKey
                                    </kbd>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <form id="send-code" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Input.Code" class="form-label fw-semibold">Verification Code</label>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Enter the code from your app" />
                                    <label asp-for="Input.Code">Enter the code from your app</label>
                                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-check me-2"></i>Verify & Enable
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
