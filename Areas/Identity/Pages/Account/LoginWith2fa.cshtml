@page
@model LoginWith2faModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Two-Factor Authentication";
}

<h4 class="text-center fw-bold mb-2">Two-Factor Authentication</h4>
<p class="text-center text-muted mb-4">Enter the code from your authenticator app</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="Authenticator code" />
        <label asp-for="Input.TwoFactorCode" class="form-label">Authenticator Code</label>
        <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="Input.RememberMachine" class="form-check-input" />
        <label asp-for="Input.RememberMachine" class="form-check-label text-muted">
            Remember this device
        </label>
    </div>

    <button type="submit" class="w-100 btn btn-success btn-lg fw-semibold">
        Verify & Log In
    </button>

    <div class="text-center mt-3">
        <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="small text-muted">
            Don't have access to your authenticator? Log in with a recovery code
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
