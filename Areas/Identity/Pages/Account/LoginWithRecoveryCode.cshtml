@page
@model LoginWithRecoveryCodeModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Recovery Code";
}

<h4 class="text-center fw-bold mb-2">Recovery Code</h4>
<p class="text-center text-muted mb-4">Enter your recovery code to log in</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="form-floating mb-4">
        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Recovery code" />
        <label asp-for="Input.RecoveryCode" class="form-label">Recovery Code</label>
        <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
    </div>

    <button type="submit" class="w-100 btn btn-success btn-lg fw-semibold">
        Log In
    </button>
</form>

<p class="text-center text-muted mt-3 small">
    This login will not be remembered until you provide an authenticator app code or disable 2FA.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
