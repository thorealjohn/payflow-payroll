@page
@model itpayroll.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registration Restricted";
}

<div class="alert alert-danger mt-5">
    <h4 class="alert-heading">Registration Restricted</h4>
    <p>
        Public registration is not available. User accounts can only be created by authorized personnel
        through the User Management system.
    </p>
    <hr>
    <p class="mb-0">
        If you need an account, please contact your HR department or system administrator.
    </p>
</div>

<div class="mt-3">
    <a asp-page="./Login" class="btn btn-primary">Go to Login</a>
</div>
